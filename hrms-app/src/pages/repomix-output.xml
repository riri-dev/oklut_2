              <div className="h-full animate-pulse rounded-lg bg-muted" />
            ) : (
              <ResponsiveContainer width="100%" height="100%">
                <BarChart data={stats?.departmentDistribution ?? []} layout="vertical" margin={{ top: 0, right: 10, left: 0, bottom: 0 }}>
