                  </table>
                </div>
              )}
            </CardContent>
          </Card>
        </TabsContent>

        <TabsContent value="payroll" className="mt-4">
          <Card>
            <CardContent className="p-0">
              {employeePayroll.length === 0 ? (
                <EmptyState title="No payroll records" description="Generate payroll for this employee to see payslips." />
