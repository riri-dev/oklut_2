                        </div>
                        {lastDate && (
                          <div className="flex items-center gap-1.5 text-rose-500/80 bg-rose-50 px-2 py-0.5 rounded-md">
                            <CalendarClock className="h-4 w-4" /> Closing: {new Date(lastDate).toLocaleDateString()}
