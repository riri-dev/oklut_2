const TWO_HOURS_MS = 2 * 60 * 60 * 1000
const FIVE_MIN_MS = 5 * 60 * 1000
const ONE_HOUR_MS = 60 * 60 * 1000

function downloadOfferPdf(candidate: Candidate, offer: Offer, job?: JobOpening | null) {
  const doc = new jsPDF()
  doc.setFontSize(18)
  doc.text('Oklut Technologies', 14, 20)
  doc.setFontSize(11)
  doc.setTextColor(60)
  doc.text('Offer of Employment', 14, 28)
  doc.setTextColor(0)
  doc.setFontSize(10)

  const breakdown: SalaryBreakdown = offer.salary_breakdown ?? {
    base_salary: offer.salary_offered ?? 0,
    variable: 0,
    allowances: 0,
    gross_total: offer.salary_offered ?? 0,
  }

  autoTable(doc, {
    startY: 36,
    head: [['Offer Terms & Conditions', '']],
    body: [
      ['Candidate Name', candidate.name],
      ['Position', job?.title ?? '—'],
      ['Joining Date', formatDate(offer.joining_date || '')],
      ['Service Bond', offer.service_bond_years ? `${offer.service_bond_years} year(s)` : 'Not applicable'],
      ['Relocation', offer.relocation_required ? `Required${offer.relocation_location ? ` — ${offer.relocation_location}` : ''}` : 'Not required'],
      ['Base Salary (Annual)', formatCurrency(breakdown.base_salary)],
      ['Variable Pay (Annual)', formatCurrency(breakdown.variable)],
      ['Allowances (Annual)', formatCurrency(breakdown.allowances)],
      ['Gross Total CTC (Annual)', formatCurrency(breakdown.gross_total)],
    ],
    styles: { fontSize: 10 },
  })

  doc.setFontSize(9)
  doc.setTextColor(100)
  const finalY = (doc as unknown as { lastAutoTable?: { finalY?: number } }).lastAutoTable?.finalY ?? 120
  doc.text('By signing this offer letter, you agree to all the terms and conditions listed above.', 14, finalY + 10)
  doc.text(`Offer generated on ${formatDateTime(new Date().toISOString())} for ${candidate.email}`, 14, finalY + 16)
  doc.save(`offer-letter-${candidate.name.replace(/\s+/g, '-').toLowerCase()}.pdf`)
}

// ============================================================================
// Top navigation — theme toggle, notifications, sign out
// ============================================================================
function ThemeToggle() {
  const { theme, setTheme } = useTheme()
  return (
    <Button
      variant="ghost"
      size="icon"
      onClick={() => setTheme(theme === 'dark' ? 'light' : 'dark')}
      aria-label="Toggle theme"
    >
      {theme === 'dark' ? <Sun className="h-5 w-5" /> : <Moon className="h-5 w-5" />}
    </Button>
  )
}

interface NotificationItem {
  id: string
  title: string
  message: string
  type: 'info' | 'warning' | 'success'
  is_read: boolean
  created_at: string
  timestamp: string
}

// Local-timezone display helper — notifications never render raw UTC strings.
const formatLocalTime = (dateStr?: string | null) =>
  dateStr
    ? new Date(dateStr).toLocaleString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
      hour12: true,
    })
    : ''

const formatReadableUtcDate = (isoString?: string | null) => {
  if (!isoString) return ''
  const d = new Date(isoString)
  if (isNaN(d.getTime())) return isoString

  const options: Intl.DateTimeFormatOptions = {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
    timeZone: 'UTC',
  }
  return `${d.toLocaleString('en-US', options)} (UTC)`
}

const formatRescheduleCutoff = (scheduledIso?: string | null) => {
  if (!scheduledIso) return ''
  const scheduledMs = new Date(scheduledIso).getTime()
  const cutoffMs = scheduledMs - 2 * 60 * 60 * 1000 // 2 hours prior
  return formatReadableUtcDate(new Date(cutoffMs).toISOString())
}

const formatDualTimezoneDate = (isoString?: string | null) => {
  if (!isoString) return ''
  const d = new Date(isoString)
  if (isNaN(d.getTime())) return isoString

  // 1. UTC Standard Format
  const utcOptions: Intl.DateTimeFormatOptions = {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
    timeZone: 'UTC',
  }
  const utcFormatted = `${d.toLocaleString('en-US', utcOptions)} UTC`

  // 2. Local Device Detected Format (e.g. IST, EST, PST)
  const localOptions: Intl.DateTimeFormatOptions = {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
    timeZoneName: 'short',
  }
  const localFormatted = d.toLocaleString('en-US', localOptions)

  return `${utcFormatted} (${localFormatted})`
}

function NotificationBell({
  notifications,
  onMarkAllRead,
  onMarkAsRead,
}: {
  notifications: NotificationItem[]
  onMarkAllRead: () => void
  onMarkAsRead: (id: string) => void
}) {
  const unreadCount = notifications.filter((n) => !n.is_read).length
  const sortedNotifications = [...notifications].sort(
    (a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
  )

  return (
    <DropdownMenu>
      <DropdownMenuTrigger asChild>
        <Button variant="ghost" size="icon" className="relative" aria-label="Notifications">
          <Bell className="h-5 w-5" />
          {unreadCount > 0 && (
            <span className="absolute -right-0.5 -top-0.5 flex h-4 min-w-4 items-center justify-center rounded-full bg-destructive px-1 text-[10px] font-semibold text-white">
              {unreadCount > 9 ? '9+' : unreadCount}
            </span>
          )}
        </Button>
      </DropdownMenuTrigger>
      <DropdownMenuContent align="end" className="w-80 p-0">
        <div className="flex items-center justify-between border-b px-3 py-2">
          <DropdownMenuLabel className="p-0 text-sm font-semibold">Notifications</DropdownMenuLabel>
          <Button
            variant="ghost"
            size="sm"
            className="h-7 px-2 text-xs text-muted-foreground hover:text-foreground"
            onClick={onMarkAllRead}
          >
            Mark all as read
          </Button>
        </div>
        <div className="max-h-80 overflow-y-auto">
          {sortedNotifications.length === 0 ? (
            <div className="p-8 text-center text-sm text-muted-foreground">You're all caught up</div>
          ) : (
            <div className="p-1.5">
              {sortedNotifications.map((n) => (
                <div
                  key={n.id}
                  onClick={() => onMarkAsRead(n.id)}
                  className={`flex cursor-pointer gap-3 rounded-lg px-3 py-2.5 transition-colors hover:bg-muted ${n.is_read ? '' : 'bg-blue-50 dark:bg-blue-950/40'}`}
                >
                  <span
                    className={`mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs ${n.type === 'success'
                      ? 'bg-success/20 text-success'
                      : n.type === 'warning'
                        ? 'bg-warning/20 text-warning'
                        : 'bg-primary/20 text-primary'
                      }`}
                  >
                    {n.type === 'success' ? '✓' : n.type === 'warning' ? '!' : 'i'}
                  </span>
                  <span className="min-w-0 flex-1">
                    <span className="block truncate text-sm font-medium">{n.title}</span>
                    <span className="block text-xs text-muted-foreground">{n.message}</span>
                    <span className="mt-0.5 block text-[11px] text-muted-foreground/70">{n.timestamp}</span>
                  </span>
                </div>
              ))}
            </div>
          )}
        </div>
      </DropdownMenuContent>
    </DropdownMenu>
  )
}

export default function CandidatePortalPage() {
  const [candidateId, setCandidateId] = useState('')
  const [password, setPassword] = useState('')
  const [applications, setApplications] = useState<Candidate[]>([])
  const [activeId, setActiveId] = useState('')
  const [candidate, setCandidate] = useState<Candidate | null>(null)
  const [interviews, setInterviews] = useState<Interview[]>([])
  const [offer, setOffer] = useState<Offer | null>(null)
  const [loading, setLoading] = useState(false)
  const [selectedSlot, setSelectedSlot] = useState('')
  const [isSlotModalOpen, setIsSlotModalOpen] = useState(false)
  const [activeRoundType, setActiveRoundType] = useState<RoundKey | null>(null)
  const [showExamFeedback, setShowExamFeedback] = useState(false)
  const [showTechFeedback, setShowTechFeedback] = useState(false)
  const [showHrFeedback, setShowHrFeedback] = useState(false)
  const [slotSaving, setSlotSaving] = useState(false)
  const [notifications, setNotifications] = useState<NotificationItem[]>([])

  const pushNotification = (id: string, title: string, message: string, type: 'info' | 'warning' | 'success', timestamp?: string) => {
    setNotifications((prev) => {
      // Filter out any existing notification with the same ID to prevent duplicates
      const filtered = prev.filter((n) => n.id !== id)
      const newNotif: NotificationItem = {
        id,
        title,
        message,
        type,
        is_read: false,
        created_at: new Date().toISOString(),
        timestamp: timestamp || formatLocalTime(new Date().toISOString()),
      }
      // Prepend to top (LIFO)
      return [newNotif, ...filtered]
    })
  }

  const handleMarkAllAsRead = () => {
    setNotifications((prev) => prev.map((n) => ({ ...n, is_read: true })))
  }

  const handleMarkAsRead = (id: string) => {
    setNotifications((prev) => prev.map((n) => (n.id === id ? { ...n, is_read: true } : n)))
  }

  const loadCandidateData = async (c: Candidate) => {
    // Fetch interviews
    const { data: iData } = await supabase
      .from('interviews')
      .select('*, interviewer:employees(first_name, last_name)')
      .eq('candidate_id', c.id)
      .order('scheduled_at')
    setInterviews(iData ? (iData as Interview[]) : [])

    // Fetch offer
    const { data: oData } = await supabase.from('offers').select('*').eq('candidate_id', c.id).single()
    setOffer(oData ? (oData as Offer) : null)
  }

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault()
    if (!candidateId.trim() || !password) return
    setLoading(true)
    try {
      const { data, error } = await supabase

        .from('candidates')
        .select('*, job_opening:job_openings(*)')
        .eq('candidate_id', candidateId.trim())
        .order('applied_at')

      const list = (data ?? []) as Candidate[]
      if (error) {
        toast.error('Failed to load application. Please try again.')
        setCandidate(null)
        setApplications([])
      } else if (list.length === 0) {
        toast.error('Invalid ID or password. No application found.')
        setCandidate(null)
        setApplications([])
      } else {
        setApplications(list)
        const primary = list[0]
        setCandidate(primary)
        setActiveId(primary.id)
        await loadCandidateData(primary)
      }
    } finally {
      setLoading(false)
    }
  }

  const handleSelectApplication = async (id: string) => {
    if (id === activeId) return
    const next = applications.find((a) => a.id === id)
    if (!next) return
    setActiveId(id)
    setCandidate(next)
    setInterviews([])
    setOffer(null)
    await loadCandidateData(next)
  }

  const handleSignOut = () => {
    supabase.auth.signOut()
    // Clean reset of every portal state slice — no property lookups on the old
    // candidate here; the null guard below renders the Login view next frame.
    setCandidate(null)
    setApplications([])
    setActiveId('')
    setInterviews([])
    setOffer(null)
    setNotifications([])
  }

  const job = candidate?.job_opening ?? null
  // Round 1 routing is driven strictly by candidate.category:
  // 'Fresher' → Round 1 is the Online Exam. Any other category (e.g. 'Experienced')
  // → Round 1 is the Technical Interview directly, never gated behind an exam.
  const isFresher = (candidate?.category ?? '').toLowerCase() === 'fresher'
  const isExperienced = candidate?.category?.toLowerCase() === 'experienced'
  // Dynamic pipeline — Freshers run 3 rounds (Exam + Tech + HR), Experienced run 2 (Tech + HR).
  const totalRounds = isExperienced ? 2 : 3

  const disqualified = !!(candidate?.malpractice_flag || candidate?.cheating_detected)

  // Dynamic exam parameters — strictly from state/DB, zero fallback defaults.
  const examOpening = candidate?.job_opening as (JobOpening & {
    pass_percentage?: number | null
    passing_score?: number | null
    exam_start_time?: string | null
    exam_end_time?: string | null
    total_questions?: number | null
  }) | null
  const candidateExtensions = candidate
    ? (candidate as Candidate & {
      total_questions?: number | null
      created_at?: string | null
      exam_started_at?: string | null
      technical_interview_status?: string | null
      technical_interview_time?: string | null
      technical_interview_rescheduled?: boolean
      hr_interview_status?: string | null
      hr_interview_time?: string | null
      hr_interview_rescheduled?: boolean
      exam_feedback?: string | null
      technical_interview_feedback?: string | null
      hr_interview_feedback?: string | null
    })
    : null

  // Fetch dynamic criteria directly from state/DB
  const totalQuestions = candidate?.job_opening?.total_questions
  const passPercentage = examOpening?.pass_percentage

  // Dynamic exam percentage — computed strictly from raw DB fields, zero
  // hardcoded values. Falls back to 0 when no score or question count exists.
  const candidateQuestions = candidate?.job_opening?.total_questions
  const calculatedExamPercentage =
    candidateQuestions != null && candidateQuestions > 0 && candidate?.exam_score != null
      ? Math.round((candidate.exam_score / candidateQuestions) * 100)
      : 0
  const isExamPassed =
    examOpening?.pass_percentage != null && calculatedExamPercentage >= examOpening.pass_percentage
  // Alias kept for legacy renderers — null while no score is stored.
  const scorePercentage =
    candidate?.exam_score != null && totalQuestions != null && totalQuestions > 0 ? calculatedExamPercentage : null
  const techStatus = candidateExtensions?.technical_interview_status ?? null
  const hrStatus = candidateExtensions?.hr_interview_status ?? null
  // Cleared-status normalization — 'passed' | 'cleared' | 'completed' (any case)
  // all count as a cleared stage, matching admin-side status writes.
  const roundCleared2 = ['passed', 'cleared', 'completed'].includes((techStatus ?? '').toLowerCase())
  const roundCleared3 = ['passed', 'cleared', 'completed'].includes((hrStatus ?? '').toLowerCase())
  const overallRejected = candidate?.status === 'rejected' || techStatus === 'failed' || hrStatus === 'failed'
  const isHired = candidate?.status === 'hired'
  const awaitingEvaluation = candidate?.exam_completed_at != null && scorePercentage === null

  // Rounds cleared tallied directly off the DB fields — no derived flags.
  const roundsCleared = [isExamPassed, roundCleared2, roundCleared3].filter(Boolean).length
  const progressPct = (roundsCleared / totalRounds) * 100
  const allRequiredRoundsCleared = roundsCleared === totalRounds

  // Unattempted exam + expired window — treated as a rejection.
  // Driven purely by persisted timestamps: no exam attempt was recorded
  // (no started/completed marker and no stored score) before the window closed.
  const examEndIso = examOpening?.exam_end_time ?? examOpening?.exam_window_end
  const examExpiredUnattempted =
    examEndIso != null &&
    new Date(examEndIso).getTime() < new Date().getTime() &&
    candidate?.exam_completed_at == null &&
    candidateExtensions?.exam_started_at == null &&
    candidate?.exam_score == null

  // Live-window evaluation — TRUE while `now` falls between start and end time.
  const examStartTimeRaw = examOpening?.exam_start_time ?? examOpening?.exam_window_start
  const examEndTimeRaw = examOpening?.exam_end_time ?? examOpening?.exam_window_end
  const examStartMs = examStartTimeRaw ? new Date(examStartTimeRaw).getTime() : 0
  const examEndMs = examEndTimeRaw ? new Date(examEndTimeRaw).getTime() : 0
  const nowMs = new Date().getTime()
  const isExamLive = examStartMs > 0 && examEndMs > 0 && nowMs >= examStartMs && nowMs <= examEndMs

  // Display-only labels — built from the raw fields, never used for logic.
  // Explicit per-category evaluation: Freshers run the exam tree, Experienced
  // candidates skip the exam branches entirely.
  const candidateStatusBadge = isExperienced
    ? // --- Experienced: Tech + HR only ---
    isHired
      ? 'Hired'
      : overallRejected
        ? 'Rejected'
        : allRequiredRoundsCleared
          ? 'Shortlisted'
          : hrStatus === 'passed'
            ? 'HR Interview Passed'
            : techStatus === 'passed'
              ? 'Technical Interview Passed'
              : 'Applied'
    : // --- Fresher: Exam + Tech + HR ---
    isHired
      ? 'Hired'
      : overallRejected || (scorePercentage !== null && !isExamPassed) || examExpiredUnattempted
        ? 'Rejected'
        : allRequiredRoundsCleared
          ? 'Shortlisted'
          : hrStatus === 'passed'
            ? 'HR Interview Passed'
            : techStatus === 'passed'
              ? 'Technical Interview Passed'
              : isExamPassed
                ? 'Exam Passed'
                : 'Applied'

  // Badge color alignment — neutral for applied states, green for cleared /
  // shortlisted / hired, red for rejected.
  const statusBadgeVariant =
    candidateStatusBadge === 'Applied'
      ? 'secondary'
      : candidateStatusBadge === 'Rejected'
        ? 'destructive'
        : 'success'

  // Pipeline Round 1 badge — priority-ordered, based only on persisted
  // timestamps (no client-side flags): Submitted → In Progress → Live →
  // Expired/Unattempted → Future window.
  const examPillText =
    candidate?.exam_completed_at != null || candidate?.exam_score != null
      ? isExamPassed
        ? 'Cleared'
        : 'Not Cleared'
      : candidateExtensions?.exam_started_at != null && isExamLive
        ? 'Ongoing'
        : isExamLive
          ? 'Live'
          : examExpiredUnattempted
            ? 'Unattempted'
            : 'Scheduled'

  const rounds: RoundDef[] = useMemo(() => {
    const base: RoundDef[] = [
      { key: 'technical' as RoundKey, label: 'Technical Interview', sublabel: isFresher ? 'Stage 2 · Round 2' : 'Stage 1 · Round 1', icon: UserSearch },
      { key: 'hr' as RoundKey, label: 'HR Interview', sublabel: isFresher ? 'Stage 3 · Round 3' : 'Stage 2 · Round 2', icon: HeartHandshake },
    ]
    if (!isFresher) {
      return base
    }
    // Freshers always see the full 3-stage hierarchy — Stage 1 (Exam), Stage 2 (Technical),
    // Stage 3 (HR). Rounds not yet reachable are rendered as locked rather than omitted.
    return [{ key: 'exam' as RoundKey, label: 'Online Exam', sublabel: 'Stage 1 · Round 1', icon: ClipboardList }, ...base]
  }, [isFresher])

  const examWindow = useMemo(() => {
    const startRaw = job?.exam_window_start
    const endRaw = job?.exam_window_end
    const start = startRaw ? new Date(startRaw) : null
    const end = endRaw ? new Date(endRaw) : null
    // UTC server-time comparison — immune to local system clock tampering.
    const now = new Date().toISOString()
    const startIso = start ? start.toISOString() : null
    const endIso = end ? end.toISOString() : null
    if (startIso && now < startIso) return { open: false, reason: `Scheduled from ${formatDateTime(startRaw)} to ${formatDateTime(endRaw)}`, upcoming: true }
    if (endIso && now > endIso) return { open: false, reason: `Exam closed on ${formatDateTime(endRaw)}`, upcoming: false }
    return { open: true, reason: null as string | null, upcoming: false }
  }, [job])

  const roundInterviews = (key: RoundKey): Interview[] => {
    return interviews.filter((i) => {
      const r = i.round.toLowerCase()
      if (key === 'exam') return r === 'online exam'
      if (key === 'technical') return r === 'technical'
      return r === 'hr'
    })
  }

  const getRoundState = (key: RoundKey, prevPassed: boolean): RoundState => {
    if (key === 'exam') {
      if (isExamPassed) return 'passed'
      if (scorePercentage !== null || overallRejected || examExpiredUnattempted) return 'failed'
      if (awaitingEvaluation) return 'pending'
      return examWindow.open ? 'available' : 'locked'
    }
    // Strict gatekeeping — Technical / HR unlock ONLY after Round 1 is cleared.
    const hasExamRound = rounds.some((r) => r.key === 'exam')
    if (hasExamRound && (!isExamPassed || overallRejected)) return 'locked'
    if (!prevPassed) return 'locked'
    // Admin may mark a round cleared directly on the candidate ('passed' |
    // 'cleared' | 'completed', case-insensitive) without an interview record —
    // treat those as a passed stage so the next round unlocks immediately.
    if (key === 'technical' && roundCleared2) return 'passed'
    if (key === 'hr' && roundCleared3) return 'passed'
    const recs = roundInterviews(key)
    const done = recs.find((r) => ['passed', 'completed', 'failed'].includes(r.status ?? ''))
    if (done) return done.status === 'failed' ? 'failed' : 'passed'
    const booked = recs.find((r) => r.status === 'scheduled' && r.candidate_confirmed)
    if (booked) return 'booked'
    const bookable = recs.filter((r) => r.status === 'proposed' || (r.status === 'scheduled' && !r.candidate_confirmed))
    if (bookable.length) return 'available'
    return 'pending'
  }

  const roundStates = useMemo(() => {
    const states: Record<RoundKey, RoundState> = {} as Record<RoundKey, RoundState>
    let prevPassed = true
    for (const r of rounds) {
      const s = getRoundState(r.key, prevPassed)
      states[r.key] = s
      prevPassed = s === 'passed'
    }
    return states
  }, [rounds, interviews, candidate, examWindow, job])

  const allRoundsPassed = rounds.length > 0 && rounds.every((r) => roundStates[r.key] === 'passed')

  const handleOfferResponse = async (response: 'accept' | 'discuss' | 'reject') => {
    if (!offer) return
    // Hired status is granted ONLY on an accepted offer after the T&C checkbox is ticked.
    if (response === 'accept' && candidate) {
      const { error: candErr } = await supabase
        .from('candidates')
        .update({ status: 'hired', updated_at: new Date().toISOString() })
        .eq('id', candidate.id)
      if (candErr) {
        toast.error('Failed to update your status.')
        return
      }
      setCandidate({ ...candidate, status: 'hired' })
    }
    const { error } = await supabase
      .from('offers')
      .update({ candidate_response: response, status: response === 'accept' ? 'accepted' : response === 'reject' ? 'rejected' : offer.status })
      .eq('id', offer.id)

    if (error) {
      toast.error('Failed to submit response.')
    } else {
      toast.success('Response submitted successfully.')
      setOffer({ ...offer, candidate_response: response, status: response === 'accept' ? 'accepted' : response === 'reject' ? 'rejected' : offer.status })
    }
  }

  // --- Interview slot scheduling / rescheduling modal ---
  const activeRoundSlots = activeRoundType ? roundInterviews(activeRoundType) : []
  const activeRoundLabel = activeRoundType === 'hr' ? 'HR Interview' : 'Technical Interview'
  const isReschedule = activeRoundType
    ? !!roundInterviews(activeRoundType).find((i) => i.status === 'scheduled' && i.candidate_confirmed)
    : false
  // The candidate's confirmed slot is excluded from the picker — reschedule
  // requests can only target different available slots.
  const bookedForActiveRound = activeRoundSlots.find((i) => i.status === 'scheduled' && i.candidate_confirmed)
  const availableSlotsList: SlotOption[] =
    activeRoundSlots.length > 0
      ? activeRoundSlots
        .filter((i) => i.id !== bookedForActiveRound?.id)
        .filter((i) => !['passed', 'completed', 'failed'].includes(i.status ?? ''))
        .map((i) => ({
          value: i.id,
          label: `${formatDateTime(i.scheduled_at)}`,
          scheduled_at: i.scheduled_at,
          interviewId: i.id,
        }))
      : PLACEHOLDER_SLOTS

  const handleOpenSlotModal = (roundKey: RoundKey) => {
    setActiveRoundType(roundKey)
    setSelectedSlot('')
    setIsSlotModalOpen(true)
  }

  const handleConfirmSlot = async () => {
    if (!candidate || !activeRoundType || !selectedSlot) return
    const existingBooked = roundInterviews(activeRoundType).find((i) => i.status === 'scheduled' && i.candidate_confirmed)
    const option = availableSlotsList.find((o) => o.value === selectedSlot)
    if (!option) return
    setSlotSaving(true)
    try {
      if (existingBooked) {
        // Reschedule REQUEST — the confirmed time stays fixed until admin review.
        // The drop-down only lists slots other than the currently booked one.
        const { error } = await supabase
          .from('interviews')
          .update({ reschedule_requested: true, reschedule_status: 'pending' })
          .eq('id', existingBooked.id)
        if (error) throw error
      } else if (option.interviewId) {
        // Book an admin-published slot.
        const { error } = await supabase
          .from('interviews')
          .update({ status: 'scheduled', candidate_confirmed: true })
          .eq('id', option.interviewId)
        if (error) throw error
      } else {
        // No published slots yet — create the row from the selected placeholder.
        const { error } = await supabase.from('interviews').insert({
          candidate_id: candidate.id,
          job_opening_id: candidate.job_opening_id ?? null,
          round: activeRoundType === 'hr' ? 'HR' : 'Technical',
          scheduled_at: option.scheduled_at,
          mode: 'online',
          status: 'scheduled',
          candidate_confirmed: true,
        })
        if (error) throw error
      }
      if (existingBooked) {
        toast.success('A request to reschedule interview call has been received by our team and it will be rescheduled once the slot is available.', { duration: 6000 })
        pushNotification(
          'notif-resched-req-' + Date.now(),
          'Reschedule Request Received',
          'Your request to reschedule the interview call has been received by our team. It will be rescheduled once a slot is available — your current slot remains confirmed until then.',
          'warning'
        )
      } else {
        toast.success(`Interview scheduled for ${formatDateTime(option.scheduled_at)}`, { duration: 5000 })
        pushNotification(
          'notif-book-' + Date.now(),
          'Interview Scheduled',
          'Your technical interview has been scheduled for ' + formatReadableUtcDate(selectedSlot) + '. Note: You can reschedule this appointment until ' + formatRescheduleCutoff(selectedSlot) + ' (2 hours prior to start time).',
          'success'
        )
      }
      setIsSlotModalOpen(false)
      setSelectedSlot('')
      await loadCandidateData(candidate)
    } catch {
      toast.error('Failed to save the selected slot. Please try again.')
    } finally {
      setSlotSaving(false)
    }
  }

  const handleCancelSlot = async (roundKey: RoundKey) => {
    if (!candidate) return
    const rec = roundInterviews(roundKey).find((i) => i.status === 'scheduled' && i.candidate_confirmed)
    if (!rec) return
    setSlotSaving(true)
    try {
      const { error } = await supabase
        .from('interviews')
        .update({ status: 'cancelled', candidate_confirmed: false })
        .eq('id', rec.id)
      if (error) throw error
      toast.success('Interview slot cancelled.', { duration: 5000 })
      pushNotification('notif-cancel-' + Date.now(), 'Interview Cancelled', 'Your interview appointment has been cancelled.', 'warning')
      setSelectedSlot('')
      await loadCandidateData(candidate)
    } catch {
      toast.error('Failed to cancel the slot. Please try again.')
    } finally {
      setSlotSaving(false)
    }
  }

  const handleRevertReschedule = async (roundKey: RoundKey) => {
    if (!candidate) return
    const rec = roundInterviews(roundKey).find((i) => i.status === 'scheduled' && i.candidate_confirmed)
    if (!rec) return
    setSlotSaving(true)
    try {
      const { error } = await supabase
        .from('interviews')
        .update({ reschedule_requested: false, reschedule_status: null })
        .eq('id', rec.id)
      if (error) throw error
      toast.success('Reschedule request withdrawn — your original slot remains confirmed.', { duration: 5000 })
      pushNotification('notif-revert-' + Date.now(), 'Reschedule Request Reverted', 'Your request to reschedule the interview call has been withdrawn. Your interview remains scheduled for your original slot.', 'info')
      setSelectedSlot('')
      await loadCandidateData(candidate)
    } catch {
      toast.error('Failed to revert the reschedule request. Please try again.')
    } finally {
      setSlotSaving(false)
    }
  }

  // Category-based event evaluator — re-runs whenever candidate or interviews update.
  // No "Action Required" / pre-booking prompts are ever pushed for unscheduled interviews.
  useEffect(() => {
    if (!candidate) return

    const opening = candidate.job_opening as (JobOpening & {
      exam_start_time?: string | null
      exam_end_time?: string | null
      total_questions?: number | null
      pass_percentage?: number | null
    }) | null

    // Complete timeline — built as an explicit array, every entry derived from
    // persisted DB fields (never hardcoded lists). The final sort is strict
    // LIFO by created_at (ms), so the newest event always sits on top and the
    // registration entry — the base timestamp — always rests at the bottom.
    const nowIso = new Date().toISOString()
    const nowMs = new Date(nowIso).getTime()
    const registrationIso = candidate.applied_at ?? candidateExtensions?.created_at ?? nowIso
    const registrationMs = new Date(registrationIso).getTime()
    const allNotifications: Array<{
      id: string
      title: string
      message: string
      timestamp: string
      iso: string
      type: 'info' | 'warning' | 'success'
      read: boolean
    }> = []

    const push = (id: string, title: string, message: string, type: 'info' | 'warning' | 'success', iso: string, read = true) => {
      allNotifications.push({ id, title, message, timestamp: formatLocalTime(iso), iso, type, read })
    }

    // 1. Registration — always present, always at the very bottom of the panel.
    push(
      'registration',
      'Registration Successful',
      isExperienced
        ? 'Registration Successful. Please schedule your slot for the Technical Interview.'
        : 'Registration Successful.',
      'success',
      registrationIso
    )

    // 2. Online Exam Scheduled (Freshers only) — the admin-published exam time.
    //    created_at = registration + 1s so it never ties with the base entry.
    if (!isExperienced && (opening?.exam_start_time || opening?.exam_window_start)) {
      const examStart = opening.exam_start_time ?? opening.exam_window_start
      push(
        'exam-scheduled',
        'Online Exam Scheduled',
        `Online Exam Scheduled for ${formatLocalTime(examStart)}.`,
        'info',
        new Date(registrationMs + 1000).toISOString()
      )
    }

    // 3. Post-exam outcome (Freshers only).
    if (!isExperienced && (candidate.exam_completed_at != null || candidate.exam_score != null)) {
      const calculatedExamPercentage =
        opening?.total_questions != null && opening.total_questions > 0
          ? Math.round(((candidate.exam_score ?? 0) / opening.total_questions) * 100)
          : 0
      const examPassed = opening?.pass_percentage != null && calculatedExamPercentage >= opening.pass_percentage
      push(
        'exam-result',
        examPassed ? 'Online Exam Cleared' : 'Online Exam Status Update',
        examPassed
          ? 'You cleared the Online Exam! Please schedule your slot for the Technical Interview.'
          : 'You did not qualify the Online Exam.',
        examPassed ? 'success' : 'warning',
        candidate.exam_completed_at ?? nowIso,
        false
      )
    }

    // 4. Technical / HR round state machine — every entry mapped from the ACTUAL
    //    interview records (no static items): booking, reschedule, the combined
    //    pass-outcome + next-action prompt, and the disqualification notice.
    const techLabel = 'Technical Interview'
    const hrLabel = 'HR Interview'
    for (const record of interviews) {
      const isTech = record.round === 'Technical'
      const isHr = record.round === 'HR'
      if (!isTech && !isHr) continue
      const label = isTech ? techLabel : hrLabel
      const statusNorm = (record.status ?? '').toLowerCase()
      const isBooked = statusNorm === 'scheduled' && record.candidate_confirmed === true
      const ext = record as Interview & { reschedule_requested?: boolean | null; reschedule_status?: string | null }

      if (isBooked && ext.reschedule_requested === true && ext.reschedule_status === 'pending') {
        push(
          `resched-req-${record.id}`,
          `${label} — Reschedule Request Received`,
          'Your request to reschedule the interview call has been received by our team. Your current slot remains confirmed until a new slot is approved.',
          'warning',
          nowIso
        )
      } else if (isBooked && ext.reschedule_status === 'accepted') {
        push(
          `resched-${record.id}`,
          `${label} Rescheduled`,
          `${label} Rescheduled successfully for ${formatLocalTime(record.scheduled_at)}.`,
          'info',
          record.scheduled_at
        )
      } else if (isBooked) {
        push(
          `sched-${record.id}`,
          `${label} Scheduled`,
          `${label} Scheduled for ${formatLocalTime(record.scheduled_at)}.`,
          'info',
          record.created_at || record.scheduled_at
        )
      } else if (['passed', 'completed', 'cleared'].includes(statusNorm)) {
        push(
          `pass-${record.id}`,
          `${label} Cleared`,
          isTech
            ? 'Congratulations! You have qualified the Technical Round. Please schedule your slot for the HR Round.'
            : 'Congratulations! You cleared the HR Round. Please review terms and conditions for further steps.',
          'success',
          record.created_at || record.scheduled_at,
          false
        )
      } else if (statusNorm === 'failed') {
        push(
          `fail-${record.id}`,
          `${label} Result`,
          isTech ? 'You did not clear the Technical Round.' : 'You did not clear the HR Round.',
          'warning',
          record.created_at || record.scheduled_at,
          false
        )
      }
    }

    // 5. Candidate-level outcomes — admin may mark a round cleared / failed
    //    directly on the candidate without writing an interview record; mirror
    //    those only when no record already produced the same event above.
    const techNorm = (candidateExtensions?.technical_interview_status ?? '').toLowerCase()
    const hrNorm = (candidateExtensions?.hr_interview_status ?? '').toLowerCase()
    const hasTechTerminal = interviews.some(
      (i) => i.round === 'Technical' && ['passed', 'completed', 'cleared', 'failed'].includes((i.status ?? '').toLowerCase())
    )
    const hasHrTerminal = interviews.some(
      (i) => i.round === 'HR' && ['passed', 'completed', 'cleared', 'failed'].includes((i.status ?? '').toLowerCase())
    )
    if (!hasTechTerminal && ['passed', 'cleared', 'completed'].includes(techNorm)) {
      push('tech-outcome', 'Technical Round Cleared', 'Congratulations! You have qualified the Technical Round. Please schedule your slot for the HR Round.', 'success', candidateExtensions?.technical_interview_time ?? registrationIso, false)
    }
    if (!hasTechTerminal && techNorm === 'failed') {
      push('tech-fail', 'Technical Round Result', 'You did not clear the Technical Round.', 'warning', candidateExtensions?.technical_interview_time ?? registrationIso, false)
    }
    if (!hasHrTerminal && ['passed', 'cleared', 'completed'].includes(hrNorm)) {
      push('hr-outcome', 'HR Round Cleared', 'Congratulations! You cleared the HR Round. Please review terms and conditions for further steps.', 'success', candidateExtensions?.hr_interview_time ?? registrationIso, false)
    }
    if (!hasHrTerminal && hrNorm === 'failed') {
      push('hr-fail', 'HR Round Result', 'You did not clear the HR Round.', 'warning', candidateExtensions?.hr_interview_time ?? registrationIso, false)
    }

    // 6. One-hour notices — present in the panel ONLY once the real-world clock
    //    reaches (start − 1h); the toast engine below fires the same moment.
    if (!isExperienced) {
      const examStartRaw = opening?.exam_start_time ?? opening?.exam_window_start
      if (examStartRaw) {
        const startMs = new Date(examStartRaw).getTime()
        const reminderAtMs = startMs - ONE_HOUR_MS
        if (!isNaN(startMs) && nowMs >= reminderAtMs && nowMs < startMs) {
          push('exam-reminder', 'Online Exam Reminder', 'Your Online Exam will commence in 1 hour.', 'warning', new Date(reminderAtMs).toISOString(), false)
        }
      }
    }
    for (const record of interviews) {
      if (record.round !== 'Technical' && record.round !== 'HR') continue
      if (record.status !== 'scheduled' || record.candidate_confirmed !== true) continue
      const startMs = new Date(record.scheduled_at).getTime()
      if (isNaN(startMs)) continue
      const reminderAtMs = startMs - ONE_HOUR_MS
      if (nowMs >= reminderAtMs && nowMs < startMs) {
        const label = record.round === 'Technical' ? techLabel : hrLabel
        push(`interview-reminder-${record.id}`, `${label} Reminder`, `Your ${label} will commence in 1 hour.`, 'warning', new Date(reminderAtMs).toISOString(), false)
      }
    }

    // 7. Hired (post T&C / Offer acceptance).
    if (isHired && offer?.status === 'accepted') {
      push(
        'hired',
        'Offer Accepted - Hired!',
        'Congratulations! You have cleared all rounds and accepted the offer. You are hired!',
        'success',
        nowIso,
        false
      )
    }

    // 8. Exam expiration & disqualification (Freshers only, unattempted window).
    const examEndIso = opening?.exam_end_time ?? opening?.exam_window_end
    const hasAttempted = candidate.exam_completed_at != null || candidate.exam_score != null || candidateExtensions?.exam_started_at != null
    if (!isExperienced && examEndIso && new Date(examEndIso).getTime() < new Date().getTime() && !hasAttempted) {
      push(
        'notif-expired',
        'Exam Window Closed',
        'You did not complete the assessment within the designated window and are no longer eligible for subsequent rounds.',
        'warning',
        examEndIso,
        false
      )
    }

    // LIFO hydrate — newest first; registration (oldest base) ends up last.
    setNotifications(
      [...allNotifications]
        .sort((a, b) => new Date(b.iso).getTime() - new Date(a.iso).getTime())
        .map((n) => ({
          id: n.id,
          title: n.title,
          message: n.message,
          type: n.type,
          is_read: n.read,
          created_at: n.iso,
          timestamp: n.timestamp,
        }))
    )
  }, [candidate, interviews, offer, isExperienced])

  // Real-world time reference & toast engine — every 30s (and once per data
  // change) the engine evaluates every scheduled exam / interview call against
  // the live clock (new Date()) and fires a toast + panel notification the
  // instant now reaches the 1-hour-prior threshold. Each reminder fires once
  // per browser session (ref-based dedupe).
  const firedReminderKeys = useRef<Set<string>>(new Set())

  const fireOneHourReminder = (key: string, id: string, message: string) => {
    if (firedReminderKeys.current.has(key)) return
    firedReminderKeys.current.add(key)
    toast.info(message, { duration: 8000 })
    pushNotification(id, message, message, 'warning', new Date().toISOString())
  }

  useEffect(() => {
    if (!candidate) return
    const evaluate = () => {
      const nowMs = new Date().getTime()

      // Exam window (Freshers only).
      if (!isExperienced) {
        const examOpeningCandidate = candidate.job_opening as (JobOpening & {
          exam_start_time?: string | null
          exam_window_start?: string | null
        }) | null
        const examStartRaw = examOpeningCandidate?.exam_start_time ?? examOpeningCandidate?.exam_window_start
        if (examStartRaw) {
          const startMs = new Date(examStartRaw).getTime()
          const reminderAtMs = startMs - ONE_HOUR_MS
          if (!isNaN(startMs) && nowMs >= reminderAtMs && nowMs < startMs) {
            fireOneHourReminder('toast-exam-reminder', 'exam-reminder', 'Your Online Exam will commence in 1 hour.')
          }
        }
      }

      // Scheduled interview calls (Technical / HR).
      for (const record of interviews) {
        if (record.round !== 'Technical' && record.round !== 'HR') continue
        if (record.status !== 'scheduled' || record.candidate_confirmed !== true) continue
        const startMs = new Date(record.scheduled_at).getTime()
        if (isNaN(startMs)) continue
        const reminderAtMs = startMs - ONE_HOUR_MS
        if (nowMs >= reminderAtMs && nowMs < startMs) {
          const label = record.round === 'Technical' ? 'Technical Interview' : 'HR Interview'
          fireOneHourReminder(`toast-interview-${record.id}`, `interview-reminder-${record.id}`, `Your ${label} will commence in 1 hour.`)
        }
      }
    }
    evaluate()
    const interval = window.setInterval(evaluate, 30000)
    return () => window.clearInterval(interval)
  }, [candidate, isExperienced, interviews])

  if (!candidate) {
    return (
      <div className="min-h-screen bg-muted/30">
        <header className="sticky top-0 z-40 border-b bg-background/95 backdrop-blur">
          <div className="mx-auto flex h-14 max-w-4xl items-center justify-between px-4 sm:px-6">
            <div className="flex items-center gap-2 font-semibold">
              <Briefcase className="h-5 w-5 text-primary" />
              <span className="hidden sm:inline">Oklut Candidate Portal</span>
            </div>
            <div className="flex items-center gap-1.5">
              <ThemeToggle />
            </div>
          </div>
        </header>
        <div className="flex items-center justify-center p-4 py-12">
          <Card className="w-full max-w-md">
            <CardHeader>
              <CardTitle>Login to View Application Status</CardTitle>
              <CardDescription>Track your application status by entering your ID and Password.</CardDescription>
            </CardHeader>
            <CardContent>
              <form onSubmit={handleLogin} className="space-y-4">
                <div className="space-y-2">
                  <Label>ID</Label>
                  <Input required type="text" placeholder="Enter your ID" value={candidateId} onChange={(e) => setCandidateId(e.target.value)} />
                </div>
                <div className="space-y-2">
                  <Label>Password</Label>
                  <Input required type="password" placeholder="Enter your password" value={password} onChange={(e) => setPassword(e.target.value)} />
                </div>
                <Button type="submit" className="w-full" disabled={loading}>
                  {loading ? 'Checking...' : 'View Status'}
                </Button>
              </form>
            </CardContent>
          </Card>
        </div>
      </div>
    )
  }

  return (
    <div className="min-h-screen bg-muted/30">
      <header className="sticky top-0 z-40 border-b bg-background/95 backdrop-blur">
        <div className="mx-auto flex h-14 max-w-4xl items-center justify-between px-4 sm:px-6">
          <div className="flex items-center gap-2 font-semibold">
            <Briefcase className="h-5 w-5 text-primary" />
            <span className="hidden sm:inline">Oklut Candidate Portal</span>
          </div>
          <div className="flex items-center gap-1.5">
            <ThemeToggle />
            <NotificationBell notifications={notifications} onMarkAllRead={handleMarkAllAsRead} onMarkAsRead={handleMarkAsRead} />
            <Button variant="outline" size="sm" onClick={handleSignOut}>
              <LogOut className="mr-1.5 h-4 w-4" /> Sign Out
            </Button>
          </div>
        </div>
      </header>

      <div className="mx-auto max-w-4xl space-y-6 p-6 md:p-12 pt-6 md:pt-8">
        <div>
          <h1 className="text-3xl font-bold tracking-tight">Application Status</h1>
          <p className="text-muted-foreground">Welcome back, {candidate.name}</p>
        </div>

        <div className="grid gap-6 md:grid-cols-2">
          <Card>
            <CardHeader className="flex flex-row items-center justify-between space-y-0">
              <CardTitle>Candidate Details</CardTitle>
              {applications.length > 1 && (
                <Badge variant="secondary" className="text-xs">{applications.length} applications</Badge>
              )}
            </CardHeader>
            <CardContent className="space-y-4">
              {applications.length > 1 && (
                <div className="space-y-2">
                  <Label>Application</Label>
                  <Select value={activeId} onValueChange={handleSelectApplication}>
                    <SelectTrigger className="w-full">
                      <SelectValue placeholder="Select application" />
                    </SelectTrigger>
                    <SelectContent>
                      {applications.map((a) => (
                        <SelectItem key={a.id} value={a.id}>
                          {a.job_opening?.title ?? 'Position'} · {a.candidate_id ?? 'N/A'}
                        </SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                </div>
              )}
              <div className="space-y-3">
                <div className="flex items-center gap-3 border-b pb-3">
                  <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary/10 text-lg font-semibold text-primary">
                    {candidate.name.charAt(0).toUpperCase()}
                  </div>
                  <div>
                    <div className="text-sm text-muted-foreground">Candidate Name</div>
                    <div className="font-medium">{candidate.name}</div>
                  </div>
                </div>
                <div>
                  <div className="text-sm text-muted-foreground">Candidate ID</div>
                  <div className="font-medium">{candidate.candidate_id ?? '—'}</div>
                </div>
                <div>
                  <div className="text-sm text-muted-foreground">Job Title</div>
                  <div className="font-medium">{job?.title || 'Unknown'}</div>
                </div>
                <div>
                  <div className="text-sm text-muted-foreground">Category</div>
                  <div className="font-medium capitalize">{candidate.category ?? (isFresher ? 'Fresher' : 'Experienced')}</div>
                </div>
                <div>
                  <div className="text-sm text-muted-foreground mb-1">Status</div>
                  <Badge variant={statusBadgeVariant}>
                    {candidateStatusBadge}
                  </Badge>
                </div>
              </div>
            </CardContent>
          </Card>

          <Card>
            <CardHeader>
              <CardTitle>Interview Schedule</CardTitle>
            </CardHeader>
            <CardContent>
              {interviews.length === 0 ? (
                <div className="text-sm text-muted-foreground">No interviews scheduled yet.</div>
              ) : (
                <div className="space-y-4">
                  {interviews.map(i => (
                    <div key={i.id} className="p-3 border rounded-lg bg-card">
                      <div className="flex justify-between font-medium">
                        <span>{i.round}</span>
                        <StatusPill status={i.status || 'scheduled'} />
                      </div>
                      <div className="text-sm text-muted-foreground mt-1">
                        {formatDateTime(i.scheduled_at)}
                      </div>
                      {i.mode === 'online' && i.meeting_link && i.status === 'scheduled' && (
                        <a href={i.meeting_link} target="_blank" rel="noreferrer" className="text-primary hover:underline text-sm block mt-2">
                          Join Meeting
                        </a>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </CardContent>
          </Card>
        </div>

        {disqualified ? (
          <Alert variant="destructive">
            <ShieldAlert className="h-4 w-4" />
            <AlertTitle>Disqualified: Malpractice / AI Tool Violation Detected</AlertTitle>
            <AlertDescription>
              Your application has been disqualified due to a detected malpractice or AI tool violation during the assessment process.
              Please contact the HR team if you believe this is an error.
            </AlertDescription>
          </Alert>
        ) : (
          <>
            <Card>
              <CardHeader>
                <CardTitle>Hiring Pipeline</CardTitle>
                <CardDescription>
                  {isFresher ? 'Online Exam → Technical Interview → HR Interview' : 'Technical Interview → HR Interview'}
                </CardDescription>
              </CardHeader>
              <CardContent className="space-y-4">
                <div className="flex items-center gap-3">
                  <Progress value={progressPct} className="flex-1" />
                  <span className="text-sm font-medium whitespace-nowrap">{roundsCleared}/{totalRounds} rounds cleared</span>
                </div>
                <div className="grid gap-3">
                  {rounds.map((round, idx) => {
                    const state = roundStates[round.key]
                    const Icon = round.icon
                    return (
                      <div
                        key={round.key}
                        className={`rounded-xl border p-4 transition-colors ${state === 'locked' ? 'opacity-60 bg-muted/40' : 'bg-card'
                          }`}
                      >
                        <div className="flex items-center gap-4">
                          <div
                            className={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg ${state === 'passed' ? 'bg-green-100 text-green-700' : state === 'failed' ? 'bg-red-100 text-red-600' : 'bg-primary/10 text-primary'
                              }`}
                          >
                            {state === 'passed' ? <CheckCircle2 className="h-5 w-5" /> : state === 'failed' ? <XCircle className="h-5 w-5" /> : state === 'locked' ? <Lock className="h-5 w-5" /> : <Icon className="h-5 w-5" />}
                          </div>
                          <div className="flex-1">
                            <div className="flex items-center gap-2">
                              <span className="font-semibold">{round.sublabel}</span>
                              <span className="text-sm text-muted-foreground">·</span>
                              <span className="font-medium">{round.label}</span>
                            </div>
                            <div className="text-xs text-muted-foreground mt-0.5">
                              {state === 'passed' && 'Cleared — results shown below'}
                              {state === 'failed' && 'Not cleared in this round'}
                              {state === 'locked' && round.key === 'exam' && examWindow.reason
                                ? examWindow.reason
                                : state === 'locked' && 'Locked — clear the previous round first'}
                              {state === 'available' && round.key === 'exam' && 'Ready — take your exam within the window'}
                              {state === 'available' && round.key !== 'exam' && 'Slots available — book your slot'}
                              {state === 'booked' && 'Slot confirmed'}
                              {state === 'pending' && 'Unlocked — admin will publish slots soon'}
                            </div>
                          </div>
                          {round.key === 'exam' && examPillText === 'Live' ? (
                            <span className="bg-emerald-50 text-emerald-700 border border-emerald-200 font-semibold flex items-center px-2.5 py-1 rounded-full text-xs">
                              <span className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse mr-1.5 inline-block"></span>
                              Live
                            </span>
                          ) : round.key === 'exam' && examPillText === 'Ongoing' ? (
                            <span className="bg-amber-50 text-amber-700 border border-amber-200 font-semibold flex items-center px-2.5 py-1 rounded-full text-xs">
                              <span className="w-2 h-2 rounded-full bg-amber-500 animate-pulse mr-1.5 inline-block"></span>
                              Ongoing
                            </span>
                          ) : (
                            <Badge
                              variant={
                                round.key === 'exam'
                                  ? examPillText === 'Cleared'
                                    ? 'success'
                                    : examPillText === 'Not Cleared' || examPillText === 'Unattempted'
                                      ? 'destructive'
                                      : 'default'
                                  : state === 'passed' ? 'success' : state === 'failed' ? 'destructive' : state === 'locked' || state === 'pending' ? 'secondary' : 'default'
                              }
                            >
                              {round.key === 'exam'
                                ? examPillText
                                : state === 'passed' ? 'Cleared' : state === 'failed' ? 'Failed' : state === 'locked' ? 'Locked' : state === 'booked' ? 'Booked' : state === 'pending' ? 'Awaiting Slots' : 'Available'}
                            </Badge>
                          )}
                          {idx < rounds.length - 1 && roundStates[round.key] === 'passed' && (
                            <ArrowRight className="h-4 w-4 text-muted-foreground" />
                          )}
                        </div>

                        {/* Inline round details — expanded beneath the stage heading for
                            unlocked / cleared / in-progress rounds; hidden when locked. */}
                        {state !== 'locked' && round.key === 'exam' && (
                          <ExamRound
                            roundNumber={idx + 1}
                            candidate={candidate}
                            job={job}
                            calculatedExamPercentage={candidate?.exam_score != null ? calculatedExamPercentage : null}
                            passPercentage={passPercentage}
                            isExamPassed={isExamPassed}
                            showFeedback={showExamFeedback}
                            onToggleFeedback={() => setShowExamFeedback((v) => !v)}
                            onExamComplete={(result) => {
                              setCandidate(result.candidate)
                              setInterviews((prev) => [...prev, result.interview])
                            }}
                            onExamStarted={(startedAt) => {
                              setCandidate((prev) => (prev ? { ...prev, exam_started_at: startedAt } : prev))
                            }}
                          />
                        )}
                        {state !== 'locked' && round.key === 'technical' && (
                          <TechnicalRound
                            roundNumber={idx + 1}
                            state={state}
                            interviews={roundInterviews('technical')}
                            technical_interview_status={candidateExtensions?.technical_interview_status ?? null}
                            onOpenSchedule={handleOpenSlotModal}
                            onCancelSlot={handleCancelSlot}
                            onRevertReschedule={handleRevertReschedule}
                            feedback={candidateExtensions?.technical_interview_feedback ?? null}
                            showFeedback={showTechFeedback}
                            onToggleFeedback={() => setShowTechFeedback((v) => !v)}
                          />
                        )}
                        {state !== 'locked' && round.key === 'hr' && (
                          <HRRound
                            roundNumber={idx + 1}
                            state={state}
                            interviews={roundInterviews('hr')}
                            hr_interview_status={candidateExtensions?.hr_interview_status ?? null}
                            onOpenSchedule={handleOpenSlotModal}
                            onCancelSlot={handleCancelSlot}
                            onRevertReschedule={handleRevertReschedule}
                            feedback={candidateExtensions?.hr_interview_feedback ?? null}
                            showFeedback={showHrFeedback}
                            onToggleFeedback={() => setShowHrFeedback((v) => !v)}
                          />
                        )}
                      </div>
                    )
                  })}
                </div>
              </CardContent>
            </Card>

            {allRoundsPassed &&
              (offer ? (
                <OfferCard candidate={candidate} offer={offer} job={job} onRespond={handleOfferResponse} />
              ) : (
                <Alert className="border-primary bg-primary/5">
                  <PartyPopper className="h-4 w-4" />
                  <AlertTitle>All rounds cleared — congratulations!</AlertTitle>
                  <AlertDescription>Our HR team will be in touch with your offer letter shortly.</AlertDescription>
                </Alert>
              ))}
          </>
        )}

        <Dialog
          open={isSlotModalOpen}
          onOpenChange={(open) => {
            setIsSlotModalOpen(open)
            if (!open) setSelectedSlot('')
          }}
        >
          <DialogContent>
            <DialogHeader>
              <DialogTitle>{activeRoundLabel} — {isReschedule ? 'Reschedule' : 'Schedule'} Slot</DialogTitle>
              <DialogDescription>
                {isReschedule
                  ? 'Pick a new time for your confirmed interview.'
                  : 'Choose an available slot for your interview.'}
              </DialogDescription>
            </DialogHeader>
            <div className="space-y-4">
              <div className="space-y-2">
                <Label>Available slots</Label>
                <Select value={selectedSlot} onValueChange={setSelectedSlot}>
                  <SelectTrigger className="w-full">
                    <SelectValue placeholder="Select a slot" />
                  </SelectTrigger>
                  <SelectContent>
                    {availableSlotsList.map((o) => (
                      <SelectItem key={o.value} value={o.value}>
                        {o.label}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
                {activeRoundSlots.length === 0 && (
                  <p className="text-xs text-muted-foreground">
                    No slots published yet — sample slots shown below. Slots published from the admin portal will appear here automatically.
                  </p>
                )}
              </div>
              <div className="rounded-lg border bg-muted/40 p-3 text-xs text-muted-foreground">
                <AlertTriangle className="mr-1.5 inline h-4 w-4" />
                Note: You can reschedule your slot up to 2 hours prior to the scheduled call in case of an emergency. Late reschedules will not be entertained and will result in disqualification.
              </div>
            </div>
            <DialogFooter>
              <Button variant="outline" onClick={() => setIsSlotModalOpen(false)}>Cancel</Button>
              <Button onClick={handleConfirmSlot} disabled={!selectedSlot || slotSaving}>
                {slotSaving ? 'Saving...' : isReschedule ? 'Confirm Reschedule' : 'Book Slot'}
              </Button>
            </DialogFooter>
          </DialogContent>
        </Dialog>
      </div>
    </div>
  )
}

// ============================================================================
// Round 1 — Online Exam (Freshers)
// ============================================================================
function ExamRound({
  roundNumber,
  candidate,
  job,
  onExamComplete,
  onExamStarted,
  calculatedExamPercentage,
  passPercentage,
  isExamPassed,
  showFeedback,
  onToggleFeedback,
}: {
  roundNumber: number
  candidate: Candidate
  job: JobOpening | null
  onExamComplete: (result: { candidate: Candidate; interview: Interview }) => void
  onExamStarted: (startedAt: string) => void
  calculatedExamPercentage: number | null
  passPercentage?: number | null
  isExamPassed: boolean
  showFeedback: boolean
  onToggleFeedback: () => void
}) {
  const totalQuestions = job?.total_questions ?? 30
  const durationMins = job?.exam_duration_mins ?? 60
  const passingScore = passPercentage != null ? Number(passPercentage) : null
  const examLink = job?.exam_link?.trim()
  const examFeedback = (candidate as Candidate & { exam_feedback?: string | null }).exam_feedback

  const isRejected = candidate.status === 'rejected'
  // Persisted attempt markers — direct timestamp reads, no client-side flags.
  const examStartedAt = (candidate as Candidate & { exam_started_at?: string | null }).exam_started_at

  const [examOpen, setExamOpen] = useState(false)
  const [examStarted, setExamStarted] = useState(false)
  const [timeLeft, setTimeLeft] = useState(durationMins * 60)
  const [submitting, setSubmitting] = useState(false)
  const [feedback, setFeedback] = useState<{ score: number; passed: boolean; metrics: Record<string, number>; rating: number } | null>(null)

  useEffect(() => {
    if (!examStarted || examOpen === false) return
    if (timeLeft <= 0) {
      handleSubmitExam()
      return
    }
    const t = setTimeout(() => setTimeLeft((l) => l - 1), 1000)
    return () => clearTimeout(t)
  }, [examStarted, timeLeft, examOpen])

  const mm = String(Math.floor(timeLeft / 60)).padStart(2, '0')
  const ss = String(timeLeft % 60).padStart(2, '0')

  const handleStartExam = () => {
    setTimeLeft(durationMins * 60)
    setExamStarted(true)
  }

  const handleSubmitExam = async () => {
    if (submitting || feedback) return
    setSubmitting(true)
    // Simulated scoring engine — in production, this is the exam backend result.
    const score = Math.max(30, Math.min(100, Math.round(55 + Math.random() * 45)))
    const passed = passingScore != null && score >= passingScore
    const clamp = (n: number) => Math.max(1, Math.min(5, Math.round(n)))
    const base = (score / 100) * 5
    const metrics = {
      Accuracy: clamp(base),
      Speed: clamp(base * 0.9),
      'Problem Solving': clamp(base * 1.05),
      'Time Management': clamp(base * 0.95),
    }
    const rating = Math.round((Object.values(metrics).reduce((a, b) => a + b, 0) / 4) * 10) / 10

    const now = new Date().toISOString()
    const { error } = await supabase
      .from('candidates')
      .update({ exam_score: score, exam_completed_at: now, status: passed ? 'interview' : 'rejected', updated_at: now })
      .eq('id', candidate.id)

    const { data: interview, error: iErr } = await supabase
      .from('interviews')
      .insert({
        candidate_id: candidate.id,
        job_opening_id: candidate.job_opening_id ?? null,
        round: 'Online Exam',
        scheduled_at: now,
        mode: 'online',
        status: passed ? 'passed' : 'failed',
        metrics,
        rating,
        feedback: passed ? `Passed online exam with ${score}%` : `Failed online exam with ${score}%`,
        candidate_confirmed: true,
      })
      .select()
      .single()

    setSubmitting(false)
    if (error || iErr || !interview) {
      toast.error('Failed to submit exam. Please try again.')
      return
    }

    setFeedback({ score, passed, metrics, rating })
    setExamOpen(false)
    setExamStarted(false)
    onExamComplete({ candidate: { ...candidate, exam_score: score, exam_completed_at: now }, interview: interview as Interview })
  }

  // Strict UTC evaluation of the exam window — immune to local system clock tampering.
  // Prefers exam_start_time / exam_end_time when present on the job opening,
  // falling back to exam_window_start / exam_window_end.
  const examJob = candidate.job_opening as (JobOpening & {
    exam_start_time?: string | null
    exam_end_time?: string | null
  }) | null | undefined
  const startRaw = examJob?.exam_start_time ?? examJob?.exam_window_start
  const endRaw = examJob?.exam_end_time ?? examJob?.exam_window_end
  const nowUtc = new Date().getTime()
  const startTimeUtc = startRaw ? new Date(startRaw).getTime() : 0
  const endTimeUtc = endRaw ? new Date(endRaw).getTime() : 0

  const isBeforeStart = startTimeUtc > 0 && nowUtc < startTimeUtc
  const isAfterEnd = endTimeUtc > 0 && nowUtc > endTimeUtc
  const isWithinWindow = startTimeUtc > 0 && endTimeUtc > 0 && nowUtc >= startTimeUtc && nowUtc <= endTimeUtc

  // Unattempted because the window expired — feedback is N/A for this state.
  const examExpiredUnattempted =
    candidate.exam_completed_at == null &&
    candidate.exam_score == null &&
    isAfterEnd

  return (
    <div className="mt-4 space-y-4 rounded-xl border bg-muted/20 p-4">
      <div className="flex items-center gap-2">
        <ClipboardList className="h-4 w-4 text-primary" />
        <span className="text-sm font-semibold">Round {roundNumber} · Online Exam</span>
        <span className="text-xs text-muted-foreground">
          {examLink ? 'The exam opens in a new tab when you start.' : ''}
        </span>
      </div>
      <div className="grid gap-3 sm:grid-cols-2">
        <div className="rounded-lg border p-3 flex items-center gap-3">
          <div className="flex h-9 w-9 items-center justify-center rounded-md bg-primary/10 text-primary">
            <FileText className="h-4 w-4" />
          </div>
          <div>
            <div className="text-xs text-muted-foreground">Total Questions</div>
            <div className="font-semibold">{totalQuestions}</div>
          </div>
        </div>
        <div className="rounded-lg border p-3 flex items-center gap-3">
          <div className="flex h-9 w-9 items-center justify-center rounded-md bg-primary/10 text-primary">
            <Timer className="h-4 w-4" />
          </div>
          <div>
            <div className="text-xs text-muted-foreground">Exam Duration</div>
            <div className="font-semibold">{durationMins} minutes</div>
          </div>
        </div>
      </div>

      <div className="flex flex-wrap gap-x-6 gap-y-1 text-sm text-muted-foreground">
        {job?.exam_window_start && (
          <span className="flex items-center gap-1.5"><Clock className="h-4 w-4" /> Opens: {formatReadableUtcDate(job.exam_window_start)}</span>
        )}
        {job?.exam_window_end && (
          <span className="flex items-center gap-1.5"><CalendarClock className="h-4 w-4" /> Closes: {formatReadableUtcDate(job.exam_window_end)}</span>
        )}
        {!job?.exam_window_start && !job?.exam_window_end && (
          <div className="space-y-3 rounded-lg border bg-primary/5 p-4">
            <div className="text-sm font-semibold">Exam Instructions</div>
            <div className="text-sm">
              <span className="font-medium">Exam Window:</span>{' '}
              {formatDualTimezoneDate(startRaw) && (
                <>{formatDualTimezoneDate(startRaw)} to {formatDualTimezoneDate(endRaw)}</>
              )}
            </div>
            <div className="text-sm">
              <span className="font-medium">Duration:</span> Candidates can start the assessment at any time within this active
              window. Once started, you will have exactly {durationMins} minutes to complete the test.
            </div>
            <div className="text-sm">
              <span className="font-medium">Proctoring Rules:</span> The assessment is monitored and timed. Ensure a stable
              internet connection before beginning. Once initiated, the timer cannot be paused.
            </div>
            <div className="text-sm">
              <span className="font-medium">Results:</span> Assessment evaluations will be processed automatically, and results will be announced shortly after the exam window closes.
            </div>
          </div>
        )}
      </div>

      {candidate.exam_completed_at == null && candidate.exam_score == null && (
        examStartedAt != null ? (
          <>
            <button
              disabled
              className="px-4 py-2 bg-indigo-400 text-white font-semibold text-xs rounded-lg cursor-not-allowed shadow-sm"
            >
              Exam In Progress
            </button>
            <p className="text-xs text-gray-500 mt-2">
              Your exam is in progress — complete it before the window closes. Results will appear here once submitted.
            </p>
          </>
        ) : isBeforeStart ? (
          <>
            <Button disabled className="w-full sm:w-auto opacity-50 pointer-events-none bg-gray-400 text-white">
              Take Exam
            </Button>
            <p className="text-xs text-muted-foreground">
              Exam starts at {formatReadableUtcDate(startRaw)}. Please return during the scheduled window.
            </p>
          </>
        ) : isWithinWindow ? (
          <>
            <Button
              onClick={async () => {
                // Immediately write exam_started_at — single-attempt rule locks out retakes.
                const startedAt = new Date().toISOString()
                await supabase.from('candidates').update({ exam_started_at: startedAt, updated_at: startedAt }).eq('id', candidate.id)
                window.open(examLink ?? '', '_blank', 'noopener,noreferrer')
                toast.info('Exam opened in a new tab — complete it within the allowed duration.')
                onExamStarted(startedAt)
              }}
              className="w-full sm:w-auto"
            >
              {examLink ? <ExternalLink className="mr-2 h-4 w-4" /> : <ClipboardList className="mr-2 h-4 w-4" />}
              Take Exam
            </Button>
            <p className="text-xs text-muted-foreground">
              Exam Duration: {durationMins} mins. Total Questions: {totalQuestions}. Window closes at {formatReadableUtcDate(endRaw)}.
            </p>
          </>
        ) : isAfterEnd ? (
          <>
            <Button disabled className="w-full sm:w-auto opacity-50 pointer-events-none bg-gray-400 text-white">
              Exam Closed
            </Button>
            <p className="text-xs text-muted-foreground">
              The exam window has ended. Since the assessment was not attempted within the scheduled window, you are no longer eligible for further interview rounds.
            </p>
          </>
        ) : (
          <p className="text-sm text-muted-foreground">No exam window has been configured for this opening yet.</p>
        )
      )}

      {(calculatedExamPercentage !== null || examExpiredUnattempted) && (
        <div className={`p-4 rounded-xl border flex items-start gap-3 ${isExamPassed ? 'bg-emerald-50 border-emerald-200 text-emerald-900' : 'bg-red-50 border-red-200 text-red-900'
          }`}>
          <div className="shrink-0 mt-0.5">
            {isExamPassed ? (
              <CheckCircle2 className="w-5 h-5 text-emerald-600" />
            ) : (
              <XCircle className="w-5 h-5 text-red-600" />
            )}
          </div>
          <div className="flex-1 min-w-0">
            <h4 className="font-semibold text-sm leading-tight">
              {isExamPassed ? 'Exam Cleared' : 'Not Qualified for Further Rounds'}
            </h4>
            <p className="text-xs mt-1 leading-normal opacity-90">
              {isExamPassed
                ? `You scored ${calculatedExamPercentage}% — passing cutoff was ${passPercentage}%.`
                : calculatedExamPercentage !== null
                  ? `You did not qualify as your score of ${calculatedExamPercentage}% was below the required passing cutoff of ${passPercentage}%.`
                  : 'You did not attempt the assessment before the window closed.'}
            </p>
            <Button variant="outline" size="sm" className="mt-3" onClick={onToggleFeedback}>
              {showFeedback ? 'Hide Feedback' : 'View Feedback'}
            </Button>
            {showFeedback && (
              <div className="mt-2 rounded-lg border bg-card/60 p-4 text-sm">
                {examExpiredUnattempted ? 'N/A' : (examFeedback ?? 'Feedback will be published soon.')}
              </div>
            )}
          </div>
        </div>
      )}

      {isRejected && (
        <div className="p-4 rounded-xl border bg-red-50 border-red-200 text-red-900 flex items-start gap-3">
          <div className="shrink-0 mt-0.5">
            <XCircle className="w-5 h-5 text-red-600" />
          </div>
          <div className="flex-1 min-w-0">
            <h4 className="font-semibold text-sm leading-tight text-red-900">
              Not qualified for further rounds
            </h4>
            <p className="text-xs mt-1 text-red-700 leading-normal">
              You did not qualify for further rounds as your assessment score was below the required passing cutoff of {passPercentage}%. You are welcome to apply for future opportunities.
            </p>
          </div>
        </div>
      )}

      <Dialog open={examOpen} onOpenChange={(open) => {
        if (!open && examStarted && !feedback) return
        setExamOpen(open)
      }}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>Online Exam — {job?.title ?? 'Assessment'}</DialogTitle>
            <DialogDescription>
              {totalQuestions} questions · {durationMins} minutes · Passing score {passingScore ?? '—'}%
            </DialogDescription>
          </DialogHeader>
          {!examStarted ? (
            <div className="space-y-4">
              <div className="rounded-lg border bg-muted/40 p-4 text-sm text-muted-foreground">
                <ul className="list-disc pl-5 space-y-1">
                  <li>The timer starts as soon as you begin. The exam auto-submits when time runs out.</li>
                  <li>Do not switch tabs or use AI tools — violation leads to automatic disqualification.</li>
                  <li>Your post-exam feedback is shown immediately after submission.</li>
                </ul>
              </div>
              <DialogFooter>
                <Button onClick={handleStartExam}><ArrowRight className="mr-2 h-4 w-4" /> Start Exam</Button>
              </DialogFooter>
            </div>
          ) : (
            <div className="space-y-4">
              <div className="flex items-center justify-between rounded-lg border bg-primary/5 px-4 py-3">
                <span className="text-sm font-medium"><FileText className="mr-1.5 inline h-4 w-4" />Question 1 of {totalQuestions}</span>
                <span className="flex items-center gap-1.5 font-mono font-semibold text-primary"><Timer className="h-4 w-4" />{mm}:{ss}</span>
              </div>
              <div className="rounded-lg border p-4">
                <p className="text-sm text-muted-foreground">
                  Sample question panel — in production the exam engine streams questions here. Select your answer from the options below.
                </p>
                <div className="mt-3 space-y-2">
                  {['Option A', 'Option B', 'Option C', 'Option D'].map((o) => (
                    <div key={o} className="rounded-md border px-3 py-2 text-sm cursor-pointer hover:bg-muted/60">
                      {o}
                    </div>
                  ))}
                </div>
              </div>
              <DialogFooter>
                <Button onClick={handleSubmitExam} disabled={submitting} variant="default">
                  {submitting ? 'Submitting...' : 'Submit Exam'}
                </Button>
              </DialogFooter>
            </div>
          )}
        </DialogContent>
      </Dialog>

      <Dialog open={!!feedback} onOpenChange={(open) => !open && setFeedback(null)}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle className="flex items-center gap-2">
              {feedback?.passed ? <Award className="h-5 w-5 text-green-600" /> : <XCircle className="h-5 w-5 text-red-600" />}
              Post-Exam Feedback
            </DialogTitle>
            <DialogDescription>
              {feedback?.passed ? `Congratulations! You passed with ${feedback.score}%.` : `You scored ${feedback?.score}% (passing: ${passingScore ?? '—'}%).`}
            </DialogDescription>
          </DialogHeader>
          {feedback && <MetricFeedback metrics={feedback.metrics} title="Performance Metrics" />}
          <DialogFooter>
            <Button onClick={() => setFeedback(null)}>Continue</Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  )
}

// ============================================================================
// Round 2 — Technical Interview
// ============================================================================
function TechnicalRound({
  roundNumber,
  state,
  interviews,
  technical_interview_status,
  onOpenSchedule,
  onCancelSlot,
  onRevertReschedule,
  feedback,
  showFeedback,
  onToggleFeedback,
}: {
  roundNumber: number
  state: RoundState
  interviews: Interview[]
  technical_interview_status?: string | null
  onOpenSchedule: (key: RoundKey) => void
  onCancelSlot: (key: RoundKey) => void
  onRevertReschedule: (key: RoundKey) => void
  feedback?: string | null
  showFeedback: boolean
  onToggleFeedback: () => void
}) {
  // Round 2 state reads candidate.technical_interview_status directly:
  // null | 'scheduled' | 'passed' | 'failed' (or 'cleared'/'completed')
  const statusRaw = technical_interview_status ?? null
  const status = ['passed', 'cleared', 'completed'].includes((statusRaw ?? '').toLowerCase()) ? 'passed' : statusRaw
  const booked = interviews.find((i) => i.status === 'scheduled' && i.candidate_confirmed)
  const extBooked = booked
    ? (booked as Interview & { reschedule_requested?: boolean | null; reschedule_status?: string | null })
    : null
  const completed = interviews.find((i) => ['passed', 'completed', 'failed'].includes(i.status ?? ''))

  // Live countdown — re-renders every 15s so the button state flips at the
  // 2-hour and 5-minute thresholds without any user interaction.
  const [, forceTick] = useState(0)
  useEffect(() => {
    if (!booked || extBooked?.reschedule_requested) return
    const t = window.setInterval(() => forceTick((v) => v + 1), 15000)
    return () => window.clearInterval(t)
  }, [booked, extBooked?.reschedule_requested])

  if (state === 'locked') return null

  // Time gating relative to the confirmed interview time.
  const msUntil = booked ? new Date(booked.scheduled_at).getTime() - Date.now() : null
  const canRequestReschedule = msUntil !== null && msUntil > TWO_HOURS_MS
  const inRescheduleWindow = msUntil !== null && msUntil > 0 && msUntil <= TWO_HOURS_MS
  const canJoin = msUntil !== null && msUntil <= FIVE_MIN_MS
  const reschedulePending = extBooked?.reschedule_requested === true && extBooked?.reschedule_status === 'pending'
  const rescheduleAccepted = extBooked?.reschedule_status === 'accepted'
  const rescheduleRejected = extBooked?.reschedule_status === 'rejected'

  return (
    <div className="mt-4 space-y-4">
      <div className="flex items-center gap-2">
        <UserSearch className="h-4 w-4 text-primary" />
        <span className="text-sm font-semibold">Round {roundNumber} · Technical Interview</span>
      </div>
      {status === 'scheduled' && booked && (
        <div className="space-y-3">
          {reschedulePending && (
            <div className="flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">
              <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0" />
              <span>A request to reschedule interview call has been received by our team and it will be rescheduled once the slot is available.</span>
            </div>
          )}
          <div className="rounded-lg border border-primary/40 bg-primary/5 p-4 space-y-2">
            <div className="flex items-center gap-2 font-medium text-primary">
              <CheckCircle2 className="h-4 w-4" /> Slot confirmed — {formatDateTime(booked.scheduled_at)}
            </div>
            <div className="text-sm text-muted-foreground">
              Mode: {booked.mode ?? 'video'}
              {booked.interviewer ? ` · Interviewer: ${booked.interviewer.first_name} ${booked.interviewer.last_name}` : ''}
            </div>

            <div className="space-y-2 border-t pt-3">
              {reschedulePending ? (
                // State C — the request is under admin review.
                <>
                  <p className="text-sm text-muted-foreground">
                    Your request to reschedule the interview call has been received by our team and is under review. We will get back to you soon based on the availability of slots.
                  </p>
                  <div className="flex flex-wrap items-center gap-3">
                    <Button size="sm" variant="outline" onClick={() => onRevertReschedule('technical')}>
                      <XCircle className="mr-2 h-4 w-4" /> Revert Request
                    </Button>
                  </div>
                </>
              ) : rescheduleAccepted ? (
                // State F — accepted, new time reflected in scheduled_at.
                <>
                  <p className="text-sm text-muted-foreground">
                    Your interview has been rescheduled to {formatDateTime(booked.scheduled_at)}.
                  </p>
                  <div className="flex flex-wrap items-center gap-3">
                    <Button
                      size="sm"
                      variant="outline"
                      disabled={!canRequestReschedule}
                      onClick={() => onOpenSchedule('technical')}
                      className={canRequestReschedule ? '' : 'text-muted-foreground opacity-60 hover:bg-transparent'}
                    >
                      <CalendarClock className="mr-2 h-4 w-4" /> Request to Reschedule
                    </Button>
                    <Button
                      size="sm"
                      variant="outline"
                      className="text-destructive hover:bg-destructive/10 hover:text-destructive"
                      onClick={() => onCancelSlot('technical')}
                    >
                      <XCircle className="mr-2 h-4 w-4" /> Cancel Slot
                    </Button>
                  </div>
                </>
              ) : rescheduleRejected ? (
                // State F — rejected, the original time stays.
                <>
                  <p className="text-sm text-muted-foreground">
                    Your request to reschedule has been rejected due to unavailability of slots. Therefore your interview call is scheduled for {formatDateTime(booked.scheduled_at)}.
                  </p>
                  <div className="flex flex-wrap items-center gap-3">
                    <Button
                      size="sm"
                      variant="outline"
                      disabled={!canRequestReschedule}
                      onClick={() => onOpenSchedule('technical')}
                      className={canRequestReschedule ? '' : 'text-muted-foreground opacity-60 hover:bg-transparent'}
                    >
                      <CalendarClock className="mr-2 h-4 w-4" /> Request to Reschedule
                    </Button>
                    <Button
                      size="sm"
                      variant="outline"
                      className="text-destructive hover:bg-destructive/10 hover:text-destructive"
                      onClick={() => onCancelSlot('technical')}
                    >
                      <XCircle className="mr-2 h-4 w-4" /> Cancel Slot
                    </Button>
                  </div>
                </>
              ) : canJoin ? (
                // State E — 5 minutes prior and through the active call window.
                <>
                  <p className="text-sm text-muted-foreground">
                    Click on the &apos;Join Interview&apos; button to attend your interview call.
                  </p>
                  <div className="flex flex-wrap items-center gap-3">
                    {booked.meeting_link ? (
                      <Button asChild className="bg-green-600 hover:bg-green-700">
                        <a href={booked.meeting_link} target="_blank" rel="noreferrer">
                          <Video className="mr-2 h-4 w-4" /> Join Interview
                        </a>
                      </Button>
                    ) : (
                      <Button disabled className="bg-green-600/40 text-white hover:bg-green-600/40">
                        <Video className="mr-2 h-4 w-4" /> Join Interview
                      </Button>
                    )}
                  </div>
                </>
              ) : inRescheduleWindow ? (
                // State D — between 2 hours and 5 minutes out: reschedule locked,
                // join disabled & faded until the 5-minute mark.
                <>
                  <p className="text-sm text-muted-foreground">
                    Your interview call is scheduled for {formatDateTime(booked.scheduled_at)}. The &apos;Join Interview&apos; button will be enabled 5 minutes prior to the scheduled time.
                  </p>
                  <div className="flex flex-wrap items-center gap-3">
                    <Button disabled className="opacity-50 cursor-not-allowed">
                      <Video className="mr-2 h-4 w-4" /> Join Interview
                    </Button>
                  </div>
                </>
              ) : (
                // State B — confirmed and more than 2 hours before the call.
                <>
                  <p className="text-sm text-muted-foreground">
                    Your Technical round interview call has been scheduled for {formatDateTime(booked.scheduled_at)}.
                  </p>
                  <div className="flex flex-wrap items-center gap-3">
                    <Button size="sm" variant="outline" onClick={() => onOpenSchedule('technical')}>
                      <CalendarClock className="mr-2 h-4 w-4" /> Request to Reschedule
                    </Button>
                    <Button
                      size="sm"
                      variant="outline"
                      className="text-destructive hover:bg-destructive/10 hover:text-destructive"
                      onClick={() => onCancelSlot('technical')}
                    >
                      <XCircle className="mr-2 h-4 w-4" /> Cancel Slot
                    </Button>
                  </div>
                </>
              )}
            </div>
          </div>
        </div>
      )}

      {status === null && (
        <div className="flex flex-wrap items-center justify-between gap-3 rounded-lg border p-3">
          <div className="text-sm text-muted-foreground">
            Please choose a slot from available slots.
          </div>
          <Button onClick={() => onOpenSchedule('technical')}>
            <CalendarClock className="mr-2 h-4 w-4" /> Schedule Interview Slot
          </Button>
        </div>
      )}

      {status === 'passed' && completed && (
        <div className="space-y-4">
          <div className="rounded-lg border p-4 space-y-3">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-2 font-medium">
                <Award className="h-4 w-4 text-green-600" /> Interviewer Scorecard
              </div>
              {completed.rating && <Badge variant="success">{completed.rating}/5</Badge>}
            </div>
            <MetricFeedback metrics={completed.metrics ?? undefined} title="4-Metric Scorecard" compact />
            {completed.interviewer && (
              <div className="text-xs text-muted-foreground">Conducted by {completed.interviewer.first_name} {completed.interviewer.last_name}</div>
            )}
          </div>
        </div>
      )}

      {status === 'failed' && completed && (
        <Alert variant="destructive">
          <XCircle className="h-4 w-4" />
          <AlertTitle>Not cleared</AlertTitle>
          <AlertDescription>This round was not cleared. Further steps are locked.</AlertDescription>
        </Alert>
      )}

      <div className="rounded-lg border bg-muted/40 p-4">
        <div className="mb-2 flex items-center gap-2 text-sm font-medium">
          <Info className="h-4 w-4 text-primary" /> Important Notes
        </div>
        <ul className="list-disc pl-5 space-y-1.5 text-xs text-muted-foreground">
          <li>You can request to reschedule up to 2 hours prior to the interview call time.</li>
          <li>To join the interview, log in/refresh the portal at the scheduled time. The &quot;Join Interview&quot; button will become visible and enabled 5 minutes prior to the call.</li>
          <li>Rescheduling is subject to slot availability. If slots are unavailable, your previously scheduled time remains fixed.</li>
          <li>If for any reason the candidate is unable to attend the interview at the chosen slot, they will be marked as disqualified.</li>
          <li>If you believe there is a mistake or require support, please contact support@oklut.com.</li>
        </ul>
      </div>

      <div className="space-y-2">
        <Button variant="outline" size="sm" onClick={onToggleFeedback}>
          {showFeedback ? 'Hide Feedback' : 'View Feedback'}
        </Button>
        {showFeedback && (
          <div className="rounded-lg border bg-muted/40 p-4 text-sm">
            {status === null ? 'N/A' : (feedback ?? 'Feedback will be published soon.')}
          </div>
        )}
      </div>
    </div>
  )
}

// ============================================================================
// Round 3 — HR Interview
// ============================================================================
function HRRound({
  roundNumber,
  state,
  interviews,
  hr_interview_status,
  onOpenSchedule,
  onCancelSlot,
  onRevertReschedule,
  feedback,
  showFeedback,
  onToggleFeedback,
}: {
  roundNumber: number
  state: RoundState
  interviews: Interview[]
  hr_interview_status?: string | null
  onOpenSchedule: (key: RoundKey) => void
  onCancelSlot: (key: RoundKey) => void
  onRevertReschedule: (key: RoundKey) => void
  feedback?: string | null
  showFeedback: boolean
  onToggleFeedback: () => void
}) {
  // Round 3 state reads candidate.hr_interview_status directly:
  // null | 'scheduled' | 'passed' | 'failed' (or 'cleared'/'completed')
  const statusRaw = hr_interview_status ?? null
  const status = ['passed', 'cleared', 'completed'].includes((statusRaw ?? '').toLowerCase()) ? 'passed' : statusRaw
  const booked = interviews.find((i) => i.status === 'scheduled' && i.candidate_confirmed)
  const extBooked = booked
    ? (booked as Interview & { reschedule_requested?: boolean | null; reschedule_status?: string | null })
    : null
  const completed = interviews.find((i) => ['passed', 'completed', 'failed'].includes(i.status ?? ''))

  // Live countdown — re-renders every 15s so the button state flips at the
  // 2-hour and 5-minute thresholds without any user interaction.
  const [, forceTick] = useState(0)
  useEffect(() => {
    if (!booked || extBooked?.reschedule_requested) return
    const t = window.setInterval(() => forceTick((v) => v + 1), 15000)
    return () => window.clearInterval(t)
  }, [booked, extBooked?.reschedule_requested])

  if (state === 'locked') return null

  // Time gating relative to the confirmed interview time.
  const msUntil = booked ? new Date(booked.scheduled_at).getTime() - Date.now() : null
  const canRequestReschedule = msUntil !== null && msUntil > TWO_HOURS_MS
  const inRescheduleWindow = msUntil !== null && msUntil > 0 && msUntil <= TWO_HOURS_MS
  const canJoin = msUntil !== null && msUntil <= FIVE_MIN_MS
  const reschedulePending = extBooked?.reschedule_requested === true && extBooked?.reschedule_status === 'pending'
  const rescheduleAccepted = extBooked?.reschedule_status === 'accepted'
  const rescheduleRejected = extBooked?.reschedule_status === 'rejected'

  return (
    <div className="mt-4 space-y-4">
      <div className="flex items-center gap-2">
        <HeartHandshake className="h-4 w-4 text-primary" />
        <span className="text-sm font-semibold">Round {roundNumber} · HR Interview</span>
      </div>
      {status === 'scheduled' && booked && (
        <div className="space-y-3">
          {reschedulePending && (
            <div className="flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">
              <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0" />
              <span>A request to reschedule interview call has been received by our team and it will be rescheduled once the slot is available.</span>
            </div>
          )}
          <div className="rounded-lg border border-primary/40 bg-primary/5 p-4 space-y-2">
            <div className="flex items-center gap-2 font-medium text-primary">
              <CheckCircle2 className="h-4 w-4" /> Slot confirmed — {formatDateTime(booked.scheduled_at)}
            </div>
            <div className="text-sm text-muted-foreground">
              Mode: {booked.mode ?? 'video'}
              {booked.interviewer ? ` · Interviewer: ${booked.interviewer.first_name} ${booked.interviewer.last_name}` : ''}
            </div>

            <div className="space-y-2 border-t pt-3">
              {reschedulePending ? (
                // State C — the request is under admin review.
                <>
                  <p className="text-sm text-muted-foreground">
                    Your request to reschedule the interview call has been received by our team and is under review. We will get back to you soon based on the availability of slots.
                  </p>
                  <div className="flex flex-wrap items-center gap-3">
                    <Button size="sm" variant="outline" onClick={() => onRevertReschedule('hr')}>
                      <XCircle className="mr-2 h-4 w-4" /> Revert Request
                    </Button>
                  </div>
                </>
              ) : rescheduleAccepted ? (
                // State F — accepted, new time reflected in scheduled_at.
                <>
                  <p className="text-sm text-muted-foreground">
                    Your interview has been rescheduled to {formatDateTime(booked.scheduled_at)}.
                  </p>
                  <div className="flex flex-wrap items-center gap-3">
                    <Button
                      size="sm"
                      variant="outline"
                      disabled={!canRequestReschedule}
                      onClick={() => onOpenSchedule('hr')}
                      className={canRequestReschedule ? '' : 'text-muted-foreground opacity-60 hover:bg-transparent'}
                    >
                      <CalendarClock className="mr-2 h-4 w-4" /> Request to Reschedule
                    </Button>
                    <Button
                      size="sm"
                      variant="outline"
                      className="text-destructive hover:bg-destructive/10 hover:text-destructive"
                      onClick={() => onCancelSlot('hr')}
                    >
                      <XCircle className="mr-2 h-4 w-4" /> Cancel Slot
                    </Button>
                  </div>
                </>
              ) : rescheduleRejected ? (
                // State F — rejected, the original time stays.
                <>
                  <p className="text-sm text-muted-foreground">
                    Your request to reschedule has been rejected due to unavailability of slots. Therefore your interview call is scheduled for {formatDateTime(booked.scheduled_at)}.
                  </p>
                  <div className="flex flex-wrap items-center gap-3">
                    <Button
                      size="sm"
                      variant="outline"
                      disabled={!canRequestReschedule}
                      onClick={() => onOpenSchedule('hr')}
                      className={canRequestReschedule ? '' : 'text-muted-foreground opacity-60 hover:bg-transparent'}
                    >
                      <CalendarClock className="mr-2 h-4 w-4" /> Request to Reschedule
                    </Button>
                    <Button
                      size="sm"
                      variant="outline"
                      className="text-destructive hover:bg-destructive/10 hover:text-destructive"
                      onClick={() => onCancelSlot('hr')}
                    >
                      <XCircle className="mr-2 h-4 w-4" /> Cancel Slot
                    </Button>
                  </div>
                </>
              ) : canJoin ? (
                // State E — 5 minutes prior and through the active call window.
                <>
                  <p className="text-sm text-muted-foreground">
                    Click on the &apos;Join Interview&apos; button to attend your interview call.
                  </p>
                  <div className="flex flex-wrap items-center gap-3">
                    {booked.meeting_link ? (
                      <Button asChild className="bg-green-600 hover:bg-green-700">
                        <a href={booked.meeting_link} target="_blank" rel="noreferrer">
                          <Video className="mr-2 h-4 w-4" /> Join Interview
                        </a>
                      </Button>
                    ) : (
                      <Button disabled className="bg-green-600/40 text-white hover:bg-green-600/40">
                        <Video className="mr-2 h-4 w-4" /> Join Interview
                      </Button>
                    )}
                  </div>
                </>
              ) : inRescheduleWindow ? (
                // State D — between 2 hours and 5 minutes out: reschedule locked,
                // join disabled & faded until the 5-minute mark.
                <>
                  <p className="text-sm text-muted-foreground">
                    Your interview call is scheduled for {formatDateTime(booked.scheduled_at)}. The &apos;Join Interview&apos; button will be enabled 5 minutes prior to the scheduled time.
                  </p>
                  <div className="flex flex-wrap items-center gap-3">
                    <Button disabled className="opacity-50 cursor-not-allowed">
                      <Video className="mr-2 h-4 w-4" /> Join Interview
                    </Button>
                  </div>
                </>
              ) : (
                // State B — confirmed and more than 2 hours before the call.
                <>
                  <p className="text-sm text-muted-foreground">
                    Your HR round interview call has been scheduled for {formatDateTime(booked.scheduled_at)}.
                  </p>
                  <div className="flex flex-wrap items-center gap-3">
                    <Button size="sm" variant="outline" onClick={() => onOpenSchedule('hr')}>
                      <CalendarClock className="mr-2 h-4 w-4" /> Request to Reschedule
                    </Button>
                    <Button
                      size="sm"
                      variant="outline"
                      className="text-destructive hover:bg-destructive/10 hover:text-destructive"
                      onClick={() => onCancelSlot('hr')}
                    >
                      <XCircle className="mr-2 h-4 w-4" /> Cancel Slot
                    </Button>
                  </div>
                </>
              )}
            </div>
          </div>
        </div>
      )}

      {status === null && (
        <div className="flex flex-wrap items-center justify-between gap-3 rounded-lg border p-3">
          <div className="text-sm text-muted-foreground">
            Please choose a slot from available slots.
          </div>
          <Button onClick={() => onOpenSchedule('hr')}>
            <CalendarClock className="mr-2 h-4 w-4" /> Schedule Interview Slot
          </Button>
        </div>
      )}

      {status === 'passed' && completed && (
        <div className="space-y-4">
          <div className="rounded-lg border p-4 space-y-3">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-2 font-medium">
                <Award className="h-4 w-4 text-green-600" /> Interviewer Scorecard
              </div>
              {completed.rating && <Badge variant="success">{completed.rating}/5</Badge>}
            </div>
            <MetricFeedback metrics={completed.metrics ?? undefined} title="4-Metric Scorecard" compact />
            {completed.interviewer && (
              <div className="text-xs text-muted-foreground">Conducted by {completed.interviewer.first_name} {completed.interviewer.last_name}</div>
            )}
          </div>
        </div>
      )}

      {status === 'failed' && completed && (
        <Alert variant="destructive">
          <XCircle className="h-4 w-4" />
          <AlertTitle>Not cleared</AlertTitle>
          <AlertDescription>This round was not cleared. Further steps are locked.</AlertDescription>
        </Alert>
      )}

      <div className="rounded-lg border bg-muted/40 p-4">
        <div className="mb-2 flex items-center gap-2 text-sm font-medium">
          <Info className="h-4 w-4 text-primary" /> Important Notes
        </div>
        <ul className="list-disc pl-5 space-y-1.5 text-xs text-muted-foreground">
          <li>You can request to reschedule up to 2 hours prior to the interview call time.</li>
          <li>To join the interview, log in/refresh the portal at the scheduled time. The &quot;Join Interview&quot; button will become visible and enabled 5 minutes prior to the call.</li>
          <li>Rescheduling is subject to slot availability. If slots are unavailable, your previously scheduled time remains fixed.</li>
          <li>If for any reason the candidate is unable to attend the interview at the chosen slot, they will be marked as disqualified.</li>
          <li>If you believe there is a mistake or require support, please contact support@oklut.com.</li>
        </ul>
      </div>

      <div className="space-y-2">
        <Button variant="outline" size="sm" onClick={onToggleFeedback}>
          {showFeedback ? 'Hide Feedback' : 'View Feedback'}
        </Button>
        {showFeedback && (
          <div className="rounded-lg border bg-muted/40 p-4 text-sm">
            {status === null ? 'N/A' : (feedback ?? 'Feedback will be published soon.')}
          </div>
        )}
      </div>
    </div>
  )
}

// ============================================================================
// Shared — 4-metric feedback / scorecard rendering
// ============================================================================
function MetricFeedback({ metrics, title, compact }: { metrics?: Record<string, number> | null; title: string; compact?: boolean }) {
  const entries = Object.entries(metrics ?? {})
  if (entries.length === 0) return null
  return (
    <div className={compact ? 'space-y-2' : 'space-y-3'}>
      {title && <div className="text-sm font-medium">{title}</div>}
      {entries.map(([name, value]) => {
        const v = Math.max(0, Math.min(5, Number(value) || 0))
        const pct = (v / 5) * 100
        return (
          <div key={name}>
            <div className="mb-1 flex items-center justify-between text-sm">
              <span>{name}</span>
              <span className="font-semibold">{v}/5</span>
            </div>
            <Progress value={pct} className={v >= 3.5 ? 'bg-green-600' : v >= 2.5 ? 'bg-amber-500' : 'bg-red-500'} />
          </div>
        )
      })}
    </div>
  )
}

// ============================================================================
// Offer — dynamic terms & conditions
// ============================================================================
function OfferCard({
  candidate,
  offer,
  job,
  onRespond,
}: {
  candidate: Candidate
  offer: Offer
  job: JobOpening | null
  onRespond: (response: 'accept' | 'discuss' | 'reject') => void
}) {
  const [accepted, setAccepted] = useState(false)
  const breakdown: SalaryBreakdown = offer.salary_breakdown ?? {
    base_salary: offer.salary_offered ?? 0,
    variable: 0,
    allowances: 0,
    gross_total: offer.salary_offered ?? 0,
  }

  return (
    <Card className="border-primary bg-primary/5">
      <CardHeader>
        <CardTitle className="flex items-center gap-2">
          <Briefcase className="h-5 w-5" /> Job Offer — {candidate.name}
        </CardTitle>
        <CardDescription>Congratulations! You have cleared all rounds. Review and accept the terms below.</CardDescription>
      </CardHeader>
      <CardContent className="space-y-6">
        <div className="grid gap-4 sm:grid-cols-2">
          <div className="rounded-lg border bg-card p-3">
            <div className="flex items-center gap-2 text-sm font-medium"><Briefcase className="h-4 w-4 text-primary" /> Position</div>
            <div className="mt-1 text-sm">{job?.title ?? '—'}</div>
          </div>
          <div className="rounded-lg border bg-card p-3">
            <div className="flex items-center gap-2 text-sm font-medium"><CalendarClock className="h-4 w-4 text-primary" /> Expected Joining</div>
            <div className="mt-1 text-sm">{formatDate(offer.joining_date || '')}</div>
          </div>
          <div className="rounded-lg border bg-card p-3">
            <div className="flex items-center gap-2 text-sm font-medium"><Lock className="h-4 w-4 text-primary" /> Service Bond</div>
            <div className="mt-1 text-sm">
              {offer.service_bond_years ? `${offer.service_bond_years} year${offer.service_bond_years > 1 ? 's' : ''} custom service bond applies` : 'No service bond applicable'}
            </div>
          </div>
          <div className="rounded-lg border bg-card p-3">
            <div className="flex items-center gap-2 text-sm font-medium"><MapPin className="h-4 w-4 text-primary" /> Relocation Clause</div>
            <div className="mt-1 text-sm">
              {offer.relocation_required ? `Relocation required${offer.relocation_location ? ` — ${offer.relocation_location}` : ''}` : 'Relocation not required'}
            </div>
          </div>
        </div>

        <div>
          <div className="mb-2 text-sm font-medium">CTC Breakdown (Annual)</div>
          <div className="rounded-lg border bg-card divide-y">
            {[
              ['Base Salary', formatCurrency(breakdown.base_salary)],
              ['Variable Pay', formatCurrency(breakdown.variable)],
              ['Allowances', formatCurrency(breakdown.allowances)],
            ].map(([label, value]) => (
              <div key={label} className="flex items-center justify-between px-4 py-2.5 text-sm">
                <span className="text-muted-foreground">{label}</span>
                <span>{value}</span>
              </div>
            ))}
            <div className="flex items-center justify-between px-4 py-3 text-sm font-semibold">
              <span>Gross Total</span>
              <span className="text-primary">{formatCurrency(breakdown.gross_total)}</span>
            </div>
          </div>
        </div>

        <div className="flex flex-wrap gap-3 pt-2">
          <Button variant="outline" onClick={() => downloadOfferPdf(candidate, offer, job)}>
            <Download className="mr-2 h-4 w-4" /> Download Offer PDF
          </Button>
          {offer.offer_letter_url && (
            <Button variant="outline" asChild>
              <a href={offer.offer_letter_url} target="_blank" rel="noreferrer">
                <FileText className="mr-2 h-4 w-4" /> View Offer Letter
              </a>
            </Button>
          )}
        </div>

        <div className="border-t pt-4 space-y-4">
          {offer.candidate_response ? (
            <div>
              <div className="text-sm text-muted-foreground mb-1">Your Response</div>
              <StatusPill status={offer.candidate_response} />
            </div>
          ) : (
            <div className="space-y-4">
              <div className="flex items-start gap-3 rounded-lg border bg-card p-3">
                <Checkbox id="accept-terms" checked={accepted} onCheckedChange={(v) => setAccepted(v === true)} />
                <Label htmlFor="accept-terms" className="text-sm font-normal leading-snug">
                  I, <span className="font-semibold">{candidate.name}</span>, accept all the terms and conditions mentioned above,
                  including the service bond, relocation clause and the offered CTC breakdown.
                </Label>
              </div>
              <div className="flex flex-wrap gap-3">
                <Button onClick={() => onRespond('accept')} disabled={!accepted} className="bg-green-600 hover:bg-green-700">
                  Accept Offer
                </Button>
                <Button onClick={() => onRespond('discuss')} variant="outline">Discuss Terms</Button>
                <Button onClick={() => onRespond('reject')} variant="destructive">Decline</Button>
              </div>
              {!accepted && <p className="text-xs text-muted-foreground">Tick the acceptance checkbox above to enable the Accept Offer button.</p>}
            </div>
          )}
        </div>
      </CardContent>
    </Card>
  )
}
