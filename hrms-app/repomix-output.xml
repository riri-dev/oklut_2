                    </td>
                    <td className="px-4 py-2.5">
                      {(() => {
                        const parsedScore = c.source?.includes('(ATS:') ? parseInt(c.source.split('(ATS: ')[1]) : undefined
                        const displayScore = c.ats_score ?? parsedScore
                        return displayScore ? (
