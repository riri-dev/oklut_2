# Copy this file to .env and fill in your Supabase project values.
# Find them at: Supabase Dashboard -> Project Settings -> API
# 1) Create a project at https://supabase.com/dashboard
# 2) Fill the two values below
# 3) Apply the schema: open supabase/full_setup.sql in the SQL Editor and run it
#    (this single file now covers migrations 0001 through 0010)
# 4) Verify with: npm run verify:supabase

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Only needed for the bulk seed push script (scripts/push-seed.mjs):
#   paste from Supabase Dashboard -> Project Settings -> API -> service_role
#   into a local .env.local file (never commit it), then run: npm run push:seed
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: base URL for shared links / notifications
VITE_APP_URL=http://localhost:5173
