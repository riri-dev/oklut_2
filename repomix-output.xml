        .dash-sidebar { position: fixed; top: 0; left: 0; width: 280px; height: 100vh; background: #fff; box-shadow: 0 1px 20px 0 rgba(69,90,100,0.08); z-index: 1025; transition: all 0.15s ease-in-out; }
        .dash-sidebar .navbar-wrapper { height: 100%; display: flex; flex-direction: column; }
