                if (arr) { arr.classList.toggle('ti-chevron-down'); arr.classList.toggle('ti-chevron-right'); } }
        }
        function toggleDropdown(e) {
            e.preventDefault();
            var d = document.getElementById('userDropdown');
            d.style.display = d.style.display === 'none' || d.style.display === '' ? 'block' : 'none';
        }
        document.addEventListener('click', function(e) {
            var d = document.getElementById('userDropdown');
            var t = document.querySelector('.drp-company .dash-head-link');
            if (d && t && !t.contains(e.target) && !d.contains(e.target)) d.style.display = 'none';
