    e.preventDefault()
    if (!title.trim() || !content.trim()) return
    await create.mutateAsync({
      title: title.trim(),
      content: content.trim(),
      audience: audience === 'all' ? undefined : audience,
      department_id: audience === 'department' ? departmentId || undefined : undefined,
