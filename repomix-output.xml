    <section class="hero">
        <div class="float-card fc-1"><div class="fc-tag">IT</div><div class="fc-title">PHP Developer</div><div class="fc-meta"><i class="ti ti-map-pin"></i> Hyderabad</div></div>
        <div class="float-card fc-2"><div class="fc-tag">Design</div><div class="fc-title">UI Designer</div><div class="fc-meta"><i class="ti ti-map-pin"></i> Hyderabad</div></div>
        <div class="float-card fc-3"><div class="fc-ico bg-primary"><i class="ti ti-code"></i></div><div class="fc-title">Software Engineer</div><div class="fc-meta"><i class="ti ti-map-pin"></i> Bangalore</div></div>
        <div class="float-card fc-4"><div class="fc-tag">HR</div><div class="fc-title">HR Executive</div><div class="fc-meta"><i class="ti ti-map-pin"></i> Bangalore</div></div>
        <div class="float-card fc-5"><div class="fc-tag">Finance</div><div class="fc-title">Accountant</div><div class="fc-meta"><i class="ti ti-map-pin"></i> Hyderabad</div></div>
        <div class="container-c hero-inner">
            <h1>We help businesses grow</h1>
            <p class="sub">Work there. Find the dream job you've always wanted.</p>
            <a class="hero-cta" href="#openings"><i class="ti ti-arrow-down"></i> Explore Jobs</a>
        </div>
    </section>

    <section class="section" id="openings">
        <div class="container-c">
            <div class="section-head">
                <h2 id="openingsTitle">+0 Job Openings</h2>
                <p>Always looking for better ways to do things, innovate and help people achieve their goals.</p>
            </div>
            <div class="jobs-grid" id="jobsGrid"></div>
            <div class="no-jobs" id="noJobs" style="display:none;">
                <i class="ti ti-briefcase"></i>
                <p>No open positions right now. Please check back soon!</p>
            </div>
        </div>
    </section>

    <footer class="site-footer">
        <div class="container-c">
            <span class="text-muted">&copy; 2026 sample &mdash; We help businesses grow.</span>
        </div>
    </footer>

    <div class="modal-backdrop" id="detailModal" style="display:none;">
        <div class="modal-box">
            <div class="modal-head">
                <h3 id="detailTitle"></h3>
                <button type="button" class="modal-close" onclick="closeDetail()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="job-detail-top">
                    <div class="dt">
                        <div class="dt-ico"><i class="ti ti-briefcase"></i></div>
                        <div>
                            <h2 id="detailJobTitle"></h2>
                            <div class="dt-meta">
                                <span><i class="ti ti-map-pin"></i> <span id="detailLoc"></span></span>
                                <span><i class="ti ti-users"></i> <span id="detailOpenings"></span> positions available</span>
                                <span><i class="ti ti-clock"></i> <span id="detailType"></span></span>
                            </div>
                        </div>
                    </div>
                    <span class="badge-chip open" id="detailStatus"></span>
                </div>
                <div class="job-detail-block">
                    <h4>Job Description</h4>
                    <p id="detailDesc"></p>
                    <h4>Requirements</h4>
                    <ul id="detailReq"></ul>
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn-ghost" onclick="closeDetail()">Close</button>
                <button class="btn-primary" onclick="openApply()"><i class="ti ti-send"></i> Apply Now</button>
            </div>
        </div>
    </div>

    <div class="modal-backdrop" id="applyModal" style="display:none;">
        <div class="modal-box">
            <div class="modal-head">
                <h3 id="applyTitle">Apply Now</h3>
                <button type="button" class="modal-close" onclick="closeApply()">&times;</button>
            </div>
            <div class="modal-body">
                <div id="applyFormWrap">
                    <div class="job-detail-top" style="margin-bottom: 20px;">
                        <div>
                            <h2 style="font-size:20px;" id="applyJobTitle"></h2>
                            <div class="dt-meta"><span><i class="ti ti-map-pin"></i> <span id="applyLoc"></span></span></div>
                        </div>
                    </div>
                    <div class="row g-3" style="display:flex;flex-wrap:wrap;margin:-8px;">
                        <div style="flex:0 0 100%;max-width:100%;padding:8px;">
                            <div class="form-group" style="margin-bottom:0;"><label>Full Name *</label><input type="text" class="form-control" id="apName" placeholder="Your full name"></div>
                        </div>
                        <div style="flex:0 0 50%;max-width:50%;padding:8px;">
                            <div class="form-group" style="margin-bottom:0;"><label>Email *</label><input type="email" class="form-control" id="apEmail" placeholder="you@email.com"></div>
                        </div>
                        <div style="flex:0 0 50%;max-width:50%;padding:8px;">
                            <div class="form-group" style="margin-bottom:0;"><label>Phone *</label><input type="tel" class="form-control" id="apPhone" placeholder="+91 00000 00000"></div>
                        </div>
                        <div style="flex:0 0 100%;max-width:100%;padding:8px;">
                            <div class="form-group" style="margin-bottom:0;"><label>Resume Upload *</label><input type="file" class="form-control" id="apResume" accept=".pdf,.doc,.docx"></div>
                            <div class="file-hint">Accepted formats: PDF, DOC, DOCX</div>
                        </div>
                        <div style="flex:0 0 100%;max-width:100%;padding:8px;">
                            <div class="form-group" style="margin-bottom:0;"><label>Cover Letter</label><textarea class="form-control" id="apCover" placeholder="Why do you want to join us?"></textarea></div>
                        </div>
                    </div>
                    <div id="formError" class="text-danger" style="display:none;margin-top:10px;"></div>
                </div>
                <div class="success-box" id="applySuccess" style="display:none;">
                    <div class="ok-ico"><i class="ti ti-circle-check"></i></div>
                    <h3>Application Submitted!</h3>
                    <p>Thank you for applying. Our HR team will review your application and get back to you soon.</p>
                    <button class="btn-primary" onclick="closeApply()">Done</button>
                </div>
            </div>
            <div class="modal-foot" id="applyFoot">
                <button class="btn-ghost" onclick="closeApply()">Cancel</button>
                <button class="btn-primary" onclick="submitApply()"><i class="ti ti-send"></i> Submit Application</button>
            </div>
        </div>
    </div>

    <div class="toast" id="toast"></div>

    <script>
        var JOBS_KEY = 'hrms_career_jobs';
        var APPS_KEY = 'hrms_career_applications';
        var currentDetailJob = null;
        var currentApplyJob = null;

        function defaultJobs() {
            return [
                { id: 'JB-se-001', title: 'Software Engineer', department: 'IT', location: 'Hyderabad', openings: 2, description: 'Build and maintain scalable web applications using modern PHP and JavaScript frameworks. Collaborate with cross-functional teams to deliver high-quality features on time.', requirements: '3+ years of experience in PHP development\nStrong knowledge of MySQL and REST APIs\nExperience with Git and agile workflows\nGood problem-solving and communication skills', employmentType: 'Full-time', status: 'Open', published: true, createdAt: '2026-07-01' },
                { id: 'JB-php-001', title: 'PHP Developer', department: 'IT', location: 'Hyderabad', openings: 2, description: 'Develop robust server-side logic, integrate front-end elements and build reusable, testable code. Work closely with designers and product managers to ship features for our clients.', requirements: '2+ years of PHP (Laravel) experience\nSolid understanding of HTML, CSS and JavaScript\nExperience with PostgreSQL or MySQL\nFamiliarity with version control (Git)', employmentType: 'Full-time', status: 'Open', published: true, createdAt: '2026-07-02' },
                { id: 'JB-ui-001', title: 'UI Designer', department: 'Design', location: 'Hyderabad', openings: 1, description: 'Design clean, modern and intuitive interfaces for our HRM platform. Build design systems, wireframes and interactive prototypes that delight users.', requirements: '2+ years of UI/UX design experience\nProficiency with Figma or Sketch\nStrong portfolio demonstrating visual design skills\nKnowledge of responsive design principles', employmentType: 'Full-time', status: 'Open', published: true, createdAt: '2026-07-03' },
                { id: 'JB-hr-001', title: 'HR Executive', department: 'HR', location: 'Bangalore', openings: 1, description: 'Support the HR team in recruitment, onboarding and employee engagement. Maintain HR records and assist with payroll and policy administration.', requirements: '1-3 years of HR experience\nStrong organizational and communication skills\nKnowledge of labour laws is a plus\nProficiency in MS Office', employmentType: 'Full-time', status: 'Open', published: true, createdAt: '2026-06-25' },
                { id: 'JB-acc-001', title: 'Accountant', department: 'Finance', location: 'Hyderabad', openings: 1, description: 'Handle day-to-day accounting operations, reconciliations and month-end closing. Prepare financial reports and support audits.', requirements: '2-4 years of accounting experience\nKnowledge of Tally or similar ERP\nStrong attention to detail\nFamiliarity with tax regulations', employmentType: 'Full-time', status: 'Closed', published: true, createdAt: '2026-06-15' },
                { id: 'JB-mkt-001', title: 'Marketing Lead', department: 'Marketing', location: 'Mumbai', openings: 1, description: 'Own the marketing strategy for our product lines. Lead campaigns, manage brand presence and drive lead generation across channels.', requirements: '5-7 years of marketing experience\nExperience managing a team\nStrong analytical and storytelling skills\nBackground in B2B SaaS is a plus', employmentType: 'Full-time', status: 'Open', published: false, createdAt: '2026-06-20' }
            ];
        }

        function defaultApps() {
            return [
                { id: 'AP-001', jobId: 'JB-se-001', name: 'Ravi Kumar', email: 'ravi.k@email.com', phone: '+91 98765 43210', resumeName: 'Ravi_Kumar_Resume.pdf', coverLetter: 'I have 4 years of experience building scalable PHP applications and I am excited about the opportunity to contribute to your engineering team.', appliedAt: '2026-07-02' },
                { id: 'AP-002', jobId: 'JB-se-001', name: 'Neha Gupta', email: 'neha.g@email.com', phone: '+91 91234 56780', resumeName: 'Neha_Gupta_CV.pdf', coverLetter: 'Passionate software engineer with a strong background in PHP and React. I believe my skills align well with this role.', appliedAt: '2026-07-03' },
                { id: 'AP-003', jobId: 'JB-php-001', name: 'Arun Nair', email: 'arun.n@email.com', phone: '+91 90000 12345', resumeName: 'Arun_Nair_Resume.pdf', coverLetter: 'Laravel developer with 3 years of hands-on experience. I enjoy building clean, testable backend systems.', appliedAt: '2026-07-04' }
            ];
        }

        function loadJobs() {
            var raw = localStorage.getItem(JOBS_KEY);
            if (!raw) {
                var seeds = defaultJobs();
                localStorage.setItem(JOBS_KEY, JSON.stringify(seeds));
                return seeds;
            }
            try { return JSON.parse(raw); } catch (e) { return defaultJobs(); }
        }

        function loadApps() {
            var raw = localStorage.getItem(APPS_KEY);
            if (!raw) {
                var seeds = defaultApps();
                localStorage.setItem(APPS_KEY, JSON.stringify(seeds));
                return seeds;
            }
            try { return JSON.parse(raw); } catch (e) { return []; }
        }

        function saveApps(apps) { localStorage.setItem(APPS_KEY, JSON.stringify(apps)); }

        function esc(s) {
            return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function tagFor(job) {
            if (job.tag) return job.tag;
            return job.department || job.title.split(' ')[0] || 'General';
        }

        function openJobs() {
            return loadJobs().filter(function (j) { return j.published && j.status === 'Open'; });
        }

        function render() {
            var jobs = openJobs();
            document.getElementById('openingsTitle').textContent = '+' + jobs.length + ' Job Openings';
            var grid = document.getElementById('jobsGrid');
            var noJobs = document.getElementById('noJobs');
            if (!jobs.length) {
                grid.innerHTML = '';
                noJobs.style.display = 'block';
                return;
            }
            noJobs.style.display = 'none';
            grid.innerHTML = jobs.map(function (j) {
                return '<div class="job-card" onclick="openDetail(\'' + j.id + '\')">'
                    + '<span class="jc-tag">' + esc(tagFor(j)) + '</span>'
                    + '<h3>' + esc(j.title) + '</h3>'
                    + '<div class="jc-meta">'
                    + '<span><i class="ti ti-map-pin"></i> ' + esc(j.location) + '</span>'
                    + '<span><i class="ti ti-users"></i> <span class="jc-openings">' + esc(j.openings) + ' positions available</span></span>'
                    + '<span><i class="ti ti-clock"></i> ' + esc(j.employmentType) + '</span>'
                    + '</div>'
                    + '<div class="jc-foot"><button class="jc-btn" onclick="event.stopPropagation();openDetail(\'' + j.id + '\')">View Details <i class="ti ti-arrow-right"></i></button></div>'
                    + '</div>';
            }).join('');
        }

        function openDetail(id) {
            var jobs = loadJobs();
            var job = jobs.filter(function (j) { return j.id === id; })[0];
            if (!job) return;
            currentDetailJob = job;
            document.getElementById('detailTitle').textContent = tagFor(job);
            document.getElementById('detailJobTitle').textContent = job.title;
            document.getElementById('detailLoc').textContent = job.location;
            document.getElementById('detailOpenings').textContent = job.openings;
            document.getElementById('detailType').textContent = job.employmentType;
            document.getElementById('detailStatus').textContent = job.status === 'Open' ? 'Open' : 'Closed';
            document.getElementById('detailStatus').className = 'badge-chip ' + (job.status === 'Open' ? 'open' : 'type');
            document.getElementById('detailDesc').textContent = job.description;
            var req = job.requirements.split('\n').map(function (r) { return r.trim(); }).filter(function (r) { return r; });
            document.getElementById('detailReq').innerHTML = req.map(function (r) { return '<li>' + esc(r) + '</li>'; }).join('');
            document.getElementById('detailModal').style.display = 'flex';
        }

        function closeDetail() { document.getElementById('detailModal').style.display = 'none'; }

        function openApply() {
            if (!currentDetailJob) return;
            currentApplyJob = currentDetailJob;
            document.getElementById('applyTitle').textContent = 'Apply for ' + currentApplyJob.title;
            document.getElementById('applyJobTitle').textContent = currentApplyJob.title;
            document.getElementById('applyLoc').textContent = currentApplyJob.location;
            document.getElementById('apName').value = '';
            document.getElementById('apEmail').value = '';
            document.getElementById('apPhone').value = '';
            document.getElementById('apResume').value = '';
            document.getElementById('apCover').value = '';
            document.getElementById('formError').style.display = 'none';
            document.getElementById('applyFormWrap').style.display = 'block';
            document.getElementById('applySuccess').style.display = 'none';
            document.getElementById('applyFoot').style.display = 'flex';
            closeDetail();
            document.getElementById('applyModal').style.display = 'flex';
        }

        function closeApply() {
            document.getElementById('applyModal').style.display = 'none';
            currentApplyJob = null;
        }

        function showToast(msg) {
            var t = document.getElementById('toast');
            t.textContent = msg;
            t.classList.add('show');
            setTimeout(function () { t.classList.remove('show'); }, 2800);
        }

        function submitApply() {
            var err = document.getElementById('formError');
            err.style.display = 'none';
            var name = document.getElementById('apName').value.trim();
            var email = document.getElementById('apEmail').value.trim();
            var phone = document.getElementById('apPhone').value.trim();
            var resume = document.getElementById('apResume').files[0];
            var cover = document.getElementById('apCover').value.trim();

            if (!name || !email || !phone) {
                err.textContent = 'Please fill in your name, email and phone number.';
                err.style.display = 'block';
                return;
            }
            if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
                err.textContent = 'Please enter a valid email address.';
                err.style.display = 'block';
                return;
            }
            if (!resume) {
                err.textContent = 'Please upload your resume.';
                err.style.display = 'block';
                return;
            }

            var apps = loadApps();
            apps.push({
                id: 'AP-' + Date.now().toString(36).toUpperCase(),
                jobId: currentApplyJob.id,
                name: name,
                email: email,
                phone: phone,
                resumeName: resume.name,
                coverLetter: cover,
                appliedAt: new Date().toISOString().slice(0, 10)
            });
            saveApps(apps);

            document.getElementById('applyFormWrap').style.display = 'none';
            document.getElementById('applyFoot').style.display = 'none';
            document.getElementById('applySuccess').style.display = 'block';
        }

        render();
    </script>
</body>
</html>
