-- ================================================================================
-- Oklut HRMS - FULL SETUP (run this ENTIRE file once in the SQL Editor)
-- Combines: 0001_schema.sql + 0002_seed.sql + 0003_storage.sql
-- Creates all tables, triggers, RLS policies, storage bucket, and seed data.
