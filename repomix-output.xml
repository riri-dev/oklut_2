    <script>
        // ===== Indian Calendar =====
        var indianHolidays = {
            '1-1': 'New Year',
            '1-14': 'Makar Sankranti / Pongal',
            '1-26': 'Republic Day',
            '2-19': 'Maha Shivaratri',
            '3-14': 'Holi',
            '3-25': 'Ugadi / Gudi Padwa',
            '3-31': 'Eid-ul-Fitr',
            '4-14': 'Baisakhi / Ambedkar Jayanti',
            '4-17': 'Rama Navami',
            '5-1': 'Labour Day',
            '6-7': 'Eid-ul-Adha',
            '7-6': 'Rath Yatra',
            '7-17': 'Muharram',
            '8-15': 'Independence Day',
            '8-26': 'Janmashtami',
            '9-7': 'Milad-un-Nabi',
            '10-1': 'Gandhi Jayanti',
            '10-2': 'Gandhi Jayanti',
            '10-7': 'Dussehra / Durga Puja',
            '10-20': 'Karwa Chauth',
            '10-25': 'Diwali',
            '10-26': 'Diwali',
            '10-27': 'Govardhan Puja',
            '10-28': 'Bhai Dooj',
            '10-29': 'Chhath Puja',
            '11-5': 'Guru Nanak Jayanti',
            '12-25': 'Christmas',
            '12-31': 'New Year Eve'
        };
        var calCurrentDate = new Date();
        var calMonth = calCurrentDate.getMonth();
        var calYear = calCurrentDate.getFullYear();

        function renderCalendar() {
            var monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
            document.getElementById('calMonthYear').textContent = monthNames[calMonth] + ' ' + calYear;

            var firstDay = new Date(calYear, calMonth, 1).getDay();
            var daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();
            var daysInPrev = new Date(calYear, calMonth, 0).getDate();

            var today = new Date();
            var tDay = today.getDate(), tMon = today.getMonth(), tYr = today.getFullYear();
            var tbody = document.getElementById('calBody');
            tbody.innerHTML = '';
            var date = 1;
            var selectedDate = null;
            var selectedName = null;

            for (var i = 0; i < 6; i++) {
                var row = document.createElement('tr');
                for (var j = 0; j < 7; j++) {
                    var cell = document.createElement('td');
                    if (i === 0 && j < firstDay) {
                        cell.textContent = daysInPrev - firstDay + j + 1;
                        cell.className = 'other-month';
                    } else if (date > daysInMonth) {
                        cell.textContent = date - daysInMonth;
                        cell.className = 'other-month';
                        date++;
                    } else {
                        var d = date;
                        var key = (calMonth + 1) + '-' + d;
                        var holidayName = indianHolidays[key];
                        cell.textContent = d;
                        if (d === tDay && calMonth === tMon && calYear === tYr) {
                            cell.className = 'today';
                        }
                        if (holidayName) {
                            cell.className = (cell.className ? cell.className + ' ' : '') + 'event-day';
                            cell.setAttribute('data-event', holidayName);
                            cell.setAttribute('data-day', d);
                            cell.onclick = (function(day, name) {
                                return function() {
                                    showEvent(day, name);
                                };
                            })(d, holidayName);
                            if (!selectedDate) { selectedDate = d; selectedName = holidayName; }
                        } else {
                            cell.onclick = (function(day) {
                                return function() {
                                    showEvent(day, null);
                                };
                            })(d);
                        }
                        date++;
                    }
                    row.appendChild(cell);
                }
                tbody.appendChild(row);
                if (date > daysInMonth) break;
            }
            showEvent(selectedDate || tDay, selectedName);
        }

        function showEvent(day, name) {
            var el = document.getElementById('calEvents');
            if (name) {
                var monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
                el.innerHTML = '<div class="event-item"><span class="event-dot"></span><strong>' + name + '</strong><span class="event-date">' + day + ' ' + monthNames[calMonth] + '</span></div>';
            } else {
                el.innerHTML = '<div class="text-muted">No events for this day</div>';
            }
        }

        function prevMonth() {
            calMonth--;
            if (calMonth < 0) { calMonth = 11; calYear--; }
            renderCalendar();
        }

        function nextMonth() {
            calMonth++;
            if (calMonth > 11) { calMonth = 0; calYear++; }
            renderCalendar();
        }

        // Hide loader
        window.addEventListener('load', function() {
            document.getElementById('loader').style.display = 'none';
            renderCalendar();
        });

        // Toggle sidebar on mobile
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('mob-open');
        }

        // Toggle submenu
        function toggleSubmenu(el) {
            var submenu = el.nextElementSibling;
            if (submenu) {
                submenu.classList.toggle('open');
                var arrow = el.querySelector('.dash-arrow i');
                if (arrow) {
                    arrow.classList.toggle('ti-chevron-down');
                    arrow.classList.toggle('ti-chevron-right');
                }
            }
        }

        // Open submenus by default for demo
        document.querySelectorAll('.dash-hasmenu > .dash-link').forEach(function(link) {
            var submenu = link.nextElementSibling;
            if (submenu && submenu.classList.contains('dash-submenu')) {
                // Uncomment to open all by default
                // submenu.classList.add('open');
            }
        });

        // Dropdown toggle
        function toggleDropdown(e) {
            e.preventDefault();
            var dropdown = document.getElementById('userDropdown');
            if (dropdown.style.display === 'none' || dropdown.style.display === '') {
                dropdown.style.display = 'block';
                dropdown.style.position = 'absolute';
                dropdown.style.top = '100%';
                dropdown.style.right = '0';
                dropdown.style.minWidth = '200px';
                dropdown.style.zIndex = '9999';
            } else {
                dropdown.style.display = 'none';
            }
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            var dropdown = document.getElementById('userDropdown');
            var toggle = document.querySelector('.drp-company .dash-head-link');
            if (dropdown && toggle && !toggle.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.style.display = 'none';
            }
        });

        // Modal functions
        function closeModal(id) {
            document.getElementById(id).style.display = 'none';
        }

        function showToast(message) {
            var toast = document.getElementById('liveToast');
            toast.querySelector('.toast-body').textContent = message;
            toast.style.display = 'flex';
            setTimeout(function() { toast.style.display = 'none'; }, 3000);
        }

        function hideToast() {
            document.getElementById('liveToast').style.display = 'none';
        }
    </script>
</body>
</html>
