    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
    timeZone: 'UTC',
  }
  const utcFormatted = `${d.toLocaleString('en-US', utcOptions)} UTC`

  // 2. Local Device Detected Format (e.g. IST, EST, PST)
  const localOptions: Intl.DateTimeFormatOptions = {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
