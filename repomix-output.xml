            </div>
            <div class="modal-foot">
                <button class="btn btn-secondary" onclick="closeAppsModal()">Close</button>
            </div>
        </div>
    </div>

    <footer class="dash-footer">
        <div class="footer-wrapper">
            <div class="py-1">
                <span class="text-muted">&copy; 2026 sample</span>
            </div>
        </div>
    </footer>

    <script>
        var JOBS_KEY = 'hrms_career_jobs';
        var APPS_KEY = 'hrms_career_applications';
        var currentAppsJobId = null;

        function defaultJobs() {
            return [
                { id: 'JB-se-001', title: 'Software Engineer', department: 'IT', location: 'Hyderabad', openings: 2, description: 'Build and maintain scalable web applications using modern PHP and JavaScript frameworks. Collaborate with cross-functional teams to deliver high-quality features on time.', requirements: '3+ years of experience in PHP development\nStrong knowledge of MySQL and REST APIs\nExperience with Git and agile workflows\nGood problem-solving and communication skills', employmentType: 'Full-time', status: 'Open', published: true, createdAt: '2026-07-01' },
                { id: 'JB-php-001', title: 'PHP Developer', department: 'IT', location: 'Hyderabad', openings: 2, description: 'Develop robust server-side logic, integrate front-end elements and build reusable, testable code. Work closely with designers and product managers to ship features for our clients.', requirements: '2+ years of PHP (Laravel) experience\nSolid understanding of HTML, CSS and JavaScript\nExperience with PostgreSQL or MySQL\nFamiliarity with version control (Git)', employmentType: 'Full-time', status: 'Open', published: true, createdAt: '2026-07-02' },
                { id: 'JB-ui-001', title: 'UI Designer', department: 'Design', location: 'Hyderabad', openings: 1, description: 'Design clean, modern and intuitive interfaces for our HRM platform. Build design systems, wireframes and interactive prototypes that delight users.', requirements: '2+ years of UI/UX design experience\nProficiency with Figma or Sketch\nStrong portfolio demonstrating visual design skills\nKnowledge of responsive design principles', employmentType: 'Full-time', status: 'Open', published: true, createdAt: '2026-07-03' },
                { id: 'JB-hr-001', title: 'HR Executive', department: 'HR', location: 'Bangalore', openings: 1, description: 'Support the HR team in recruitment, onboarding and employee engagement. Maintain HR records and assist with payroll and policy administration.', requirements: '1-3 years of HR experience\nStrong organizational and communication skills\nKnowledge of labour laws is a plus\nProficiency in MS Office', employmentType: 'Full-time', status: 'Open', published: true, createdAt: '2026-06-25' },
                { id: 'JB-acc-001', title: 'Accountant', department: 'Finance', location: 'Hyderabad', openings: 1, description: 'Handle day-to-day accounting operations, reconciliations and month-end closing. Prepare financial reports and support audits.', requirements: '2-4 years of accounting experience\nKnowledge of Tally or similar ERP\nStrong attention to detail\nFamiliarity with tax regulations', employmentType: 'Full-time', status: 'Closed', published: true, createdAt: '2026-06-15' },
                { id: 'JB-mkt-001', title: 'Marketing Lead', department: 'Marketing', location: 'Mumbai', openings: 1, description: 'Own the marketing strategy for our product lines. Lead campaigns, manage brand presence and drive lead generation across channels.', requirements: '5-7 years of marketing experience\nExperience managing a team\nStrong analytical and storytelling skills\nBackground in B2B SaaS is a plus', employmentType: 'Full-time', status: 'Open', published: false, createdAt: '2026-06-20' }
            ];
        }

        function defaultApps() {
            return [
                { id: 'AP-001', jobId: 'JB-se-001', name: 'Ravi Kumar', email: 'ravi.k@email.com', phone: '+91 98765 43210', resumeName: 'Ravi_Kumar_Resume.pdf', coverLetter: 'I have 4 years of experience building scalable PHP applications and I am excited about the opportunity to contribute to your engineering team.', appliedAt: '2026-07-02' },
                { id: 'AP-002', jobId: 'JB-se-001', name: 'Neha Gupta', email: 'neha.g@email.com', phone: '+91 91234 56780', resumeName: 'Neha_Gupta_CV.pdf', coverLetter: 'Passionate software engineer with a strong background in PHP and React. I believe my skills align well with this role.', appliedAt: '2026-07-03' },
                { id: 'AP-003', jobId: 'JB-php-001', name: 'Arun Nair', email: 'arun.n@email.com', phone: '+91 90000 12345', resumeName: 'Arun_Nair_Resume.pdf', coverLetter: 'Laravel developer with 3 years of hands-on experience. I enjoy building clean, testable backend systems.', appliedAt: '2026-07-04' }
            ];
        }

        function loadJobs() {
            var raw = localStorage.getItem(JOBS_KEY);
            if (!raw) {
                var seeds = defaultJobs();
                localStorage.setItem(JOBS_KEY, JSON.stringify(seeds));
                return seeds;
            }
            try { return JSON.parse(raw); } catch (e) { return defaultJobs(); }
        }

        function saveJobs(jobs) { localStorage.setItem(JOBS_KEY, JSON.stringify(jobs)); }

        function loadApps() {
            var raw = localStorage.getItem(APPS_KEY);
            if (!raw) {
                var seeds = defaultApps();
                localStorage.setItem(APPS_KEY, JSON.stringify(seeds));
                return seeds;
            }
            try { return JSON.parse(raw); } catch (e) { return []; }
        }

        function saveApps(apps) { localStorage.setItem(APPS_KEY, JSON.stringify(apps)); }

        function uid(prefix) { return prefix + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 5).toUpperCase(); }

        function esc(s) {
            return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function appsForJob(jobId) { return loadApps().filter(function (a) { return a.jobId === jobId; }); }

        function renderStats(jobs, apps) {
            var open = jobs.filter(function (j) { return j.status === 'Open'; }).length;
            document.getElementById('statTotal').textContent = jobs.length;
            document.getElementById('statOpen').textContent = open;
            document.getElementById('statApps').textContent = apps.length;
        }

        function renderJobs() {
            var jobs = loadJobs();
            var apps = loadApps();
            renderStats(jobs, apps);
            var tbody = document.getElementById('jobTableBody');
            var empty = document.getElementById('emptyState');
            if (!jobs.length) {
                tbody.innerHTML = '';
                empty.style.display = 'block';
                return;
            }
            empty.style.display = 'none';
            tbody.innerHTML = jobs.map(function (j) {
                var count = appsForJob(j.id).length;
                var statusBadge = j.status === 'Open'
                    ? '<span class="badge bg-success">Open</span>'
                    : '<span class="badge bg-secondary">Closed</span>';
                var pubBadge = j.published
                    ? '<span class="badge bg-info">Published</span>'
                    : '<span class="badge bg-light">Unpublished</span>';
                var typeBadge = j.employmentType === 'Contract'
                    ? '<span class="badge bg-warning">' + esc(j.employmentType) + '</span>'
                    : '<span class="badge bg-light">' + esc(j.employmentType) + '</span>';
                return '<tr>'
                    + '<td class="fw-semibold">' + esc(j.title) + '</td>'
                    + '<td>' + esc(j.department) + '</td>'
                    + '<td>' + esc(j.location) + '</td>'
                    + '<td>' + esc(j.openings) + '</td>'
                    + '<td>' + typeBadge + '</td>'
                    + '<td>' + statusBadge + ' ' + pubBadge + '</td>'
                    + '<td><a href="#" onclick="openAppsModal(\'' + j.id + '\');return false;"><span class="badge bg-info">' + count + '</span> Applicants</a></td>'
                    + '<td><div class="d-flex">'
                    + '<div class="action-btn bg-info ms-2"><a href="#" onclick="openAppsModal(\'' + j.id + '\');return false;" title="Applicants"><i class="ti ti-users text-white"></i></a></div>'
                    + '<div class="action-btn bg-info ms-2"><a href="#" onclick="editJob(\'' + j.id + '\');return false;" title="Edit"><i class="ti ti-pencil text-white"></i></a></div>'
                    + '<div class="action-btn bg-info ms-2"><a href="#" onclick="togglePublish(\'' + j.id + '\');return false;" title="' + (j.published ? 'Unpublish' : 'Publish') + '"><i class="ti ti-' + (j.published ? 'eye-off' : 'eye') + ' text-white"></i></a></div>'
                    + '<div class="action-btn bg-danger ms-2"><a href="#" onclick="deleteJob(\'' + j.id + '\');return false;" title="Delete"><i class="ti ti-trash text-white"></i></a></div>'
                    + '</div></td>'
                    + '</tr>';
            }).join('');
        }

        function openJobModal(job) {
            var isEdit = !!job;
            document.getElementById('jobModalTitle').textContent = isEdit ? 'Edit Job Posting' : 'Add Job Posting';
            document.getElementById('jobId').value = job ? job.id : '';
            document.getElementById('jobTitle').value = job ? job.title : '';
            document.getElementById('jobDept').value = job ? job.department : '';
            document.getElementById('jobLoc').value = job ? job.location : '';
            document.getElementById('jobOpenings').value = job ? job.openings : 1;
            document.getElementById('jobType').value = job ? job.employmentType : 'Full-time';
            document.getElementById('jobDesc').value = job ? job.description : '';
            document.getElementById('jobReq').value = job ? job.requirements : '';
            document.getElementById('jobStatus').value = job ? job.status : 'Open';
            document.getElementById('jobPublished').value = job ? (job.published ? '1' : '0') : '1';
            document.getElementById('jobModal').style.display = 'flex';
        }

        function closeJobModal() { document.getElementById('jobModal').style.display = 'none'; }

        function editJob(id) {
            var jobs = loadJobs();
            var job = jobs.filter(function (j) { return j.id === id; })[0];
            if (job) openJobModal(job);
        }

        function saveJob() {
            var title = document.getElementById('jobTitle').value.trim();
            var dept = document.getElementById('jobDept').value.trim();
            var loc = document.getElementById('jobLoc').value.trim();
            var openings = parseInt(document.getElementById('jobOpenings').value, 10) || 1;
            var type = document.getElementById('jobType').value;
            var desc = document.getElementById('jobDesc').value.trim();
            var req = document.getElementById('jobReq').value.trim();
            var status = document.getElementById('jobStatus').value;
            var published = document.getElementById('jobPublished').value === '1';

            if (!title || !dept || !loc || !desc) {
                alert('Please fill in Job Title, Department, Location and Job Description.');
                return;
            }

            var jobs = loadJobs();
            var id = document.getElementById('jobId').value;
            if (id) {
                for (var i = 0; i < jobs.length; i++) {
                    if (jobs[i].id === id) {
                        jobs[i].title = title; jobs[i].department = dept; jobs[i].location = loc;
                        jobs[i].openings = openings; jobs[i].employmentType = type; jobs[i].description = desc;
                        jobs[i].requirements = req; jobs[i].status = status; jobs[i].published = published;
                        jobs[i].updatedAt = new Date().toISOString();
                    }
                }
            } else {
                jobs.unshift({
                    id: uid('JB-'), title: title, department: dept, location: loc, openings: openings,
                    employmentType: type, description: desc, requirements: req, status: status,
                    published: published, createdAt: new Date().toISOString().slice(0, 10)
                });
            }
            saveJobs(jobs);
            closeJobModal();
            renderJobs();
        }

        function togglePublish(id) {
            var jobs = loadJobs();
            for (var i = 0; i < jobs.length; i++) {
                if (jobs[i].id === id) { jobs[i].published = !jobs[i].published; break; }
            }
            saveJobs(jobs);
            renderJobs();
        }

        function deleteJob(id) {
            if (!confirm('Delete this job posting? Its applications will also be removed.')) return;
            var jobs = loadJobs().filter(function (j) { return j.id !== id; });
            var apps = loadApps().filter(function (a) { return a.jobId !== id; });
            saveJobs(jobs);
            saveApps(apps);
            renderJobs();
        }

        function openAppsModal(jobId) {
            currentAppsJobId = jobId;
            var jobs = loadJobs();
            var job = jobs.filter(function (j) { return j.id === jobId; })[0];
            document.getElementById('appsModalTitle').textContent = job ? ('Applicants - ' + job.title) : 'Applicants';
            var apps = appsForJob(jobId);
            var tbody = document.getElementById('appsTableBody');
            var empty = document.getElementById('appsEmpty');
            if (!apps.length) {
                tbody.innerHTML = '';
                empty.style.display = 'block';
            } else {
                empty.style.display = 'none';
                tbody.innerHTML = apps.map(function (a) {
                    return '<tr>'
                        + '<td class="fw-semibold">' + esc(a.name) + '</td>'
                        + '<td>' + esc(a.email) + '</td>'
                        + '<td>' + esc(a.phone) + '</td>'
                        + '<td><i class="ti ti-file-text"></i> ' + esc(a.resumeName) + '</td>'
                        + '<td>' + esc(a.appliedAt) + '</td>'
                        + '<td style="max-width:260px;">' + esc(a.coverLetter) + '</td>'
                        + '</tr>';
                }).join('');
            }
            document.getElementById('appsModal').style.display = 'flex';
        }

        function closeAppsModal() {
            document.getElementById('appsModal').style.display = 'none';
            currentAppsJobId = null;
        }

        function toggleSidebar() { document.getElementById('sidebar').classList.toggle('mob-open'); }
        function toggleSubmenu(el) {
            var sub = el.nextElementSibling;
            if (sub) { sub.classList.toggle('open');
                var arr = el.querySelector('.dash-arrow i');
                if (arr) { arr.classList.toggle('ti-chevron-down'); arr.classList.toggle('ti-chevron-right'); } }
        }
        function toggleDropdown(e) {
            e.preventDefault();
            var d = document.getElementById('userDropdown');
            d.style.display = d.style.display === 'none' || d.style.display === '' ? 'block' : 'none';
        }
        document.addEventListener('click', function(e) {
            var d = document.getElementById('userDropdown');
            var t = document.querySelector('.drp-company .dash-head-link');
            if (d && t && !t.contains(e.target) && !d.contains(e.target)) d.style.display = 'none';
        });

        renderJobs();
    </script>
</body>
</html>
</file>

<file path="career.html">
<!DOCTYPE html>
<html lang="en" dir="">
<head>
    <title>Careers - We help businesses grow</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="Find the dream job you've always wanted.">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.2.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons@1.41.1/iconfont/tabler-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --color-customColor: #020434;
            --bs-primary: #51459d;
            --bs-success: #6fd943;
            --bs-info: #3ec9d6;
            --bs-warning: #ffa21d;
            --bs-danger: #ff3a6e;
            --bs-body-color: #293240;
            --bs-body-bg: #f8f9fd;
            --bs-font-sans-serif: "Open Sans", sans-serif;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: var(--bs-font-sans-serif); font-size: 16px; line-height: 1.6; color: var(--bs-body-color); background-color: var(--bs-body-bg); }
        a { color: var(--bs-primary); text-decoration: none; }
        a:hover { color: var(--color-customColor); }
        .container-c { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

        .site-header { background: #fff; box-shadow: 0 1px 20px 0 rgba(69,90,100,0.08); }
        .site-header .container-c { display: flex; align-items: center; justify-content: space-between; height: 70px; }
        .site-header .logo img { height: 38px; object-fit: contain; }
        .site-header .brand-name { font-weight: 700; font-size: 18px; color: var(--color-customColor); margin-left: 10px; }
        .site-header .nav-link-btn { background: var(--color-customColor); color: #fff; border-radius: 8px; padding: 9px 18px; font-weight: 600; font-size: 14px; border: none; cursor: pointer; }
        .site-header .nav-link-btn:hover { background: #01022a; color: #fff; }

        .hero { position: relative; overflow: hidden; background: linear-gradient(135deg, #020434 0%, #151356 40%, #2a1f6e 70%, #3a2e8f 100%); color: #fff; padding: 110px 0 130px; }
        .hero::after { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 75% 20%, rgba(110,96,220,0.35) 0%, transparent 45%), radial-gradient(circle at 15% 80%, rgba(62,201,214,0.18) 0%, transparent 40%); pointer-events: none; }
        .hero .hero-inner { position: relative; z-index: 2; }
        .hero h1 { font-size: 52px; font-weight: 700; line-height: 1.15; margin: 0 0 18px; max-width: 640px; }
        .hero p.sub { font-size: 18px; color: #d9d6f5; margin: 0 0 32px; max-width: 520px; }
        .hero .hero-cta { display: inline-flex; align-items: center; gap: 8px; background: #51459d; color: #fff; padding: 14px 28px; border-radius: 10px; font-weight: 600; font-size: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.25); }
        .hero .hero-cta:hover { background: #6459b0; color: #fff; }

        .float-card { position: absolute; background: #fff; color: #293240; border-radius: 14px; padding: 14px 16px; box-shadow: 0 18px 45px rgba(0,0,0,0.3); width: 210px; z-index: 2; animation: floaty 6s ease-in-out infinite; }
        .float-card .fc-title { font-weight: 700; font-size: 14px; margin-bottom: 4px; }
        .float-card .fc-meta { font-size: 12px; color: #6c757d; display: flex; align-items: center; gap: 6px; }
        .float-card .fc-tag { display: inline-block; background: #eee9ff; color: #51459d; font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 20px; margin-bottom: 8px; }
        .float-card .fc-ico { width: 34px; height: 34px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; color: #fff; font-size: 16px; margin-bottom: 8px; }
        .float-card.fc-1 { top: 22%; right: 8%; animation-delay: 0s; }
        .float-card.fc-2 { top: 52%; right: 24%; animation-delay: 1.5s; }
        .float-card.fc-3 { top: 14%; right: 34%; animation-delay: 0.8s; }
        .float-card.fc-4 { top: 62%; right: 4%; animation-delay: 2.2s; }
        .float-card.fc-5 { top: 36%; right: 44%; animation-delay: 3s; }
        @keyframes floaty {
            0%, 100% { transform: translateY(0) rotate(-2deg); }
            50% { transform: translateY(-16px) rotate(2deg); }
        }

        .section { padding: 80px 0; }
        .section-head { text-align: center; margin-bottom: 46px; }
        .section-head h2 { font-size: 38px; font-weight: 700; color: var(--color-customColor); margin: 0 0 12px; }
        .section-head p { font-size: 16px; color: #6c757d; max-width: 560px; margin: 0 auto; }

        .jobs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
        .job-card { background: #fff; border: 1px solid #eef0f6; border-radius: 16px; padding: 24px; box-shadow: 0 6px 30px rgba(182,186,203,0.22); transition: transform 0.18s ease, box-shadow 0.18s ease; display: flex; flex-direction: column; cursor: pointer; }
        .job-card:hover { transform: translateY(-4px); box-shadow: 0 14px 40px rgba(81,69,157,0.18); }
        .job-card .jc-tag { display: inline-block; align-self: flex-start; background: #eee9ff; color: #51459d; font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 20px; margin-bottom: 14px; }
        .job-card h3 { font-size: 20px; font-weight: 700; color: var(--color-customColor); margin: 0 0 12px; }
        .job-card .jc-meta { display: flex; flex-direction: column; gap: 6px; font-size: 14px; color: #525b69; margin-bottom: 18px; }
        .job-card .jc-meta span { display: flex; align-items: center; gap: 8px; }
        .job-card .jc-meta i { color: var(--bs-primary); font-size: 16px; }
        .job-card .jc-openings { color: #6fd943; font-weight: 600; }
        .job-card .jc-foot { margin-top: auto; padding-top: 16px; border-top: 1px solid #f1f1f1; }
        .job-card .jc-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; width: 100%; background: var(--color-customColor); color: #fff; border: none; padding: 11px 16px; border-radius: 10px; font-weight: 600; font-size: 14px; cursor: pointer; transition: background 0.15s; }
        .job-card .jc-btn:hover { background: #01022a; }
        .no-jobs { text-align: center; padding: 60px 20px; }
        .no-jobs i { font-size: 46px; color: #c6cbe0; }
        .no-jobs p { color: #6c757d; margin: 14px 0 0; }

        .site-footer { background: #fff; border-top: 1px solid #f1f1f1; padding: 26px 0; text-align: center; }
        .site-footer .text-muted { color: #6c757d; font-size: 14px; }

        .modal-backdrop { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(2,4,52,0.6); z-index: 2000; display: flex; align-items: flex-start; justify-content: center; overflow-y: auto; padding: 40px 15px; }
        .modal-box { background: #fff; border-radius: 16px; width: 100%; max-width: 720px; box-shadow: 0 16px 50px rgba(0,0,0,0.3); }
        .modal-head { display: flex; align-items: center; justify-content: space-between; padding: 22px 28px; border-bottom: 1px solid #f1f1f1; }
        .modal-head h3 { margin: 0; font-size: 22px; font-weight: 700; color: var(--color-customColor); }
        .modal-close { background: #f0f0f0; border: none; width: 32px; height: 32px; border-radius: 9px; font-size: 18px; line-height: 1; cursor: pointer; color: #525b69; }
        .modal-close:hover { background: #e2e2e2; }
        .modal-body { padding: 26px 28px; }
        .modal-foot { display: flex; justify-content: flex-end; gap: 10px; padding: 18px 28px; border-top: 1px solid #f1f1f1; }

        .job-detail-top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; }
        .job-detail-top .dt { display: flex; align-items: center; gap: 14px; }
        .job-detail-top .dt-ico { width: 52px; height: 52px; border-radius: 13px; background: #eee9ff; color: #51459d; display: flex; align-items: center; justify-content: center; font-size: 24px; }
        .job-detail-top h2 { margin: 0; font-size: 24px; font-weight: 700; color: var(--color-customColor); }
        .job-detail-top .dt-meta { font-size: 14px; color: #6c757d; display: flex; flex-wrap: wrap; gap: 14px; margin-top: 6px; }
        .job-detail-top .dt-meta span { display: inline-flex; align-items: center; gap: 6px; }
        .job-detail-top .dt-meta i { color: var(--bs-primary); }
        .badge-chip { display: inline-block; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; }
        .badge-chip.open { background: #e5f7d9; color: #4c9a1f; }
        .badge-chip.type { background: #eee9ff; color: #51459d; }
        .job-detail-block h4 { font-size: 15px; font-weight: 700; color: var(--color-customColor); text-transform: uppercase; letter-spacing: 0.5px; margin: 22px 0 10px; }
        .job-detail-block p { margin: 0 0 10px; color: #4b5464; }
        .job-detail-block ul { margin: 0; padding-left: 20px; color: #4b5464; }
        .job-detail-block li { margin-bottom: 6px; }

        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; font-size: 13px; font-weight: 600; color: #525b69; margin-bottom: 7px; }
        .form-control { width: 100%; padding: 11px 14px; font-size: 14px; border: 1px solid #d6d9e4; border-radius: 10px; background: #fff; }
        .form-control:focus { outline: none; border-color: var(--color-customColor); box-shadow: 0 0 0 0.2rem rgba(2,4,52,0.08); }
        textarea.form-control { resize: vertical; min-height: 110px; }
        .btn-primary { background: var(--color-customColor); color: #fff; border: none; padding: 12px 24px; border-radius: 10px; font-weight: 600; font-size: 14px; cursor: pointer; }
        .btn-primary:hover { background: #01022a; color: #fff; }
        .btn-ghost { background: #f0f0f0; color: #293240; border: none; padding: 12px 24px; border-radius: 10px; font-weight: 600; font-size: 14px; cursor: pointer; }
        .btn-ghost:hover { background: #e2e2e2; }
        .success-box { text-align: center; padding: 30px 10px; }
        .success-box .ok-ico { width: 72px; height: 72px; border-radius: 50%; background: #e5f7d9; color: #4c9a1f; font-size: 36px; display: flex; align-items: center; justify-content: center; margin: 0 auto 18px; }
        .success-box h3 { font-size: 22px; font-weight: 700; color: var(--color-customColor); margin: 0 0 8px; }
        .success-box p { color: #6c757d; margin: 0 0 20px; }
        .file-hint { font-size: 12px; color: #6c757d; margin-top: 5px; }
        .toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); background: #020434; color: #fff; padding: 13px 22px; border-radius: 10px; font-size: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); z-index: 3000; opacity: 0; transition: opacity 0.25s; pointer-events: none; }
        .toast.show { opacity: 1; }
        .text-danger { color: var(--bs-danger) !important; font-size: 12px; }

        @media (max-width: 992px) {
            .hero h1 { font-size: 40px; }
            .float-card { width: 170px; }
            .float-card.fc-3, .float-card.fc-5 { display: none; }
        }
        @media (max-width: 640px) {
            .hero { padding: 80px 0 100px; }
            .hero h1 { font-size: 32px; }
            .hero p.sub { font-size: 16px; }
            .float-card { display: none; }
            .section { padding: 60px 0; }
            .section-head h2 { font-size: 30px; }
        }
    </style>
</head>
<body>

    <header class="site-header">
        <div class="container-c">
            <a class="logo d-flex align-items-center" href="career.html">
                <img src="https://hrm.oklut.com/storage/uploads/logo/4_dark_logo.png?1785398578" alt="sample">
                <span class="brand-name">Careers</span>
            </a>
            <a class="nav-link-btn" href="#openings"><i class="ti ti-briefcase"></i> View Openings</a>
        </div>
